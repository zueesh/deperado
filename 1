/* ---------- IGNAR ---------- */
// Yakma: normalde birikmez (süre yenilenir). Ulti etkisindeki (ultMark) düşmanlarda her yakma ayrı bir yığın olur.
function applyBurn(e){
  const B=TUNE.ignar;
  if(!e.burn)e.burn=[];
  const wasEmpty=e.burn.length===0;
  if(e.ultMark||wasEmpty){e.burn.push(B.burnDur)}
  else{
    let i=0;
    for(let j=1;j<e.burn.length;j++)if(e.burn[j]>e.burn[i])i=j;
    e.burn[i]=B.burnDur;
  }
  if(wasEmpty)e.burnTick=B.burnTick;
}

// E hasarı: atak hasarının 3 katı. Seviyeden gelen hasar artışı 1.5 kat daha fazla güç verir.
function igniteEDamage(){
  const T=TUNE.ignar,d0=player.base.damage;
  return T.eMul*d0+T.eLevel*(player.damage-d0);
}

function cancelAimIg(){
  if(ig)ig.aiming=false;
  canvas.classList.remove("aiming");
  canvas.classList.remove("aimingFire");
}

function clampZone(x,y){
  const T=TUNE.ignar;
  let dx=x-player.x,dy=y-player.y;
  const d=Math.hypot(dx,dy);
  if(d>T.wRange){dx=dx/d*T.wRange;dy=dy/d*T.wRange}
  return{x:Math.max(T.wRadius,Math.min(W-T.wRadius,player.x+dx)),y:Math.max(T.wRadius,Math.min(H-T.wRadius,player.y+dy))};
}

function placeZone(pos){
  const T=TUNE.ignar,p=clampZone(pos.x,pos.y);
  ig.zone={x:p.x,y:p.y,life:T.wDur,r:T.wRadius};
  cooldowns.w=clock/1000+T.wCd;
  cancelAimIg();
  for(const e of enemies){
    if(Math.hypot(e.x-p.x,e.y-p.y)<T.wRadius+e.r)e.stun=T.wStun;   // ilk çıkışta üstündekiler hareketsiz kalır
  }
  rings.push({x:p.x,y:p.y,r:T.wRadius,life:.3,color:"#fdba74"});
  burst(p.x,p.y,"#fb923c",20);
  say("Zemin tutuştu! Üstündeki düşmanlar "+T.wStun+" sn sersemledi.");
}

function fireFlame(e){
  if(!enemies.includes(e))return;
  const sx=player.x+Math.cos(player.facing)*16,sy=player.y+Math.sin(player.facing)*16;
  if(ig.eArmed){
    ig.eArmed=false;
    flames.push({x:sx,y:sy,target:e,tx:e.x,ty:e.y,speed:460,kind:"empower",damage:igniteEDamage()});
    return;
  }
  flames.push({x:sx,y:sy,target:e,tx:e.x,ty:e.y,speed:420,kind:"flame",damage:player.damage});
}

function flameImpact(f){
  const e=f.target;
  if(!e||!enemies.includes(e))return;
  if(f.kind==="empower"){
    const dealt=Math.min(f.damage,Math.max(0,e.hp));      // fazladan giden hasar can yenilemez
    e.hp-=f.damage;
    player.hp=Math.min(player.maxHp,player.hp+dealt);
    burst(e.x,e.y,"#fcd34d",12);
    rings.push({x:e.x,y:e.y,r:e.r+16,life:.3,color:"#fcd34d"});
    if(e.hp<=0){
      killEnemy(e);
      cooldowns.e=0;
      say("Ateş Topu öldürdü! E hemen yenilendi.");
    }
  }else{
    e.hp-=f.damage;
    applyBurn(e);
    burst(e.x,e.y,"#fb923c",4);
    if(e.hp<=0)killEnemy(e);
  }
}

function endIgniteUlt(){
  cooldowns.r=clock/1000+TUNE.ignar.rCd;
  for(const e of enemies)e.ultMark=false;
  player.hp=player.maxHp;                                   // ulti bitince can tamamen dolar
  rings.push({x:player.x,y:player.y,r:TUNE.ignar.rRadius,life:.3,color:"#fdba74"});
  burst(player.x,player.y,"#fcd34d",24);
  say("İç ateş söndü! Canın tamamen doldu.");
}

function useIgnarSkill(key,now){
  const T=TUNE.ignar;
  const ready=(cooldowns[key]||0)<=now;
  if(key!=="w")cancelAimIg();
  if(key==="q"){
    if(ig.qLeft>0||!ready)return;
    ig.qLeft=T.qDur;
    cooldowns.q=1e9;                    // bekleme Q bitince başlar
    say("Alev üfleme! Baktığın yöne "+T.qDur+" sn alev püskürtürsün.");
  }
  if(key==="w"){
    if(ig.aiming){cancelAimIg();say("Nişan iptal edildi.");return}
    if(!ready)return;
    ig.aiming=true;
    canvas.classList.add("aiming");
    canvas.classList.add("aimingFire");
    say("Yakmak istediğin noktaya tıkla (iptal: W / Esc / sağ tık)");
  }
  if(key==="e"){
    if(ig.eArmed||!ready)return;
    ig.eArmed=true;
    cooldowns.e=now+T.eCd;
    say("Sonraki vuruşun ateş topu olacak! Öldürürsen E hemen yenilenir.");
  }
  if(key==="r"){
    if(ig.rLeft>0||!ready)return;
    ig.rLeft=T.rDur;ig.rTick=0;
    cooldowns.r=1e9;                    // bekleme ulti bitince başlar
    for(const e of enemies){e.ultMark=true;applyBurn(e)}   // haritadaki herkes yanar, yakma birikebilir hâle gelir
    rings.push({x:player.x,y:player.y,r:T.rRadius,life:.3,color:"#fb923c"});
    burst(player.x,player.y,"#fb923c",30);
    say("İÇ ATEŞ! Tüm düşmanlar yanıyor, "+T.rDur+" sn ateş aurası aktif.");
  }
}

function updateIgnar(dt,now){
  const T=TUNE.ignar;

  // ateş topları
  for(const f of [...flames]){
    if(f.target&&enemies.includes(f.target)){f.tx=f.target.x;f.ty=f.target.y}
    else if(f.kind==="empower"){
      let best=null,bd=1e9;
      for(const e of enemies){const dd=Math.hypot(e.x-f.x,e.y-f.y);if(dd<bd){bd=dd;best=e}}
      if(best){f.target=best;f.tx=best.x;f.ty=best.y}
      else{flames.splice(flames.indexOf(f),1);continue}
    }else{flames.splice(flames.indexOf(f),1);continue}
    const dx=f.tx-f.x,dy=f.ty-f.y,d=Math.hypot(dx,dy),step=f.speed*dt;
    if(d<step+7){flameImpact(f);flames.splice(flames.indexOf(f),1)}
    else{f.x+=dx/d*step;f.y+=dy/d*step}
  }

  // yakma hasarı (her düşmanda ayrı tık)
  for(const e of [...enemies]){
    if(e.burn&&e.burn.length){
      e.burnTick-=dt;
      while(e.burnTick<=0){
        e.burnTick+=T.burnTick;
        e.hp-=T.burnDmg*e.burn.length;                      // her yığın tık başına 1 hasar
        if(e.hp<=0)break;
      }
      for(let i=e.burn.length-1;i>=0;i--){e.burn[i]-=dt;if(e.burn[i]<=0)e.burn.splice(i,1)}
      if(e.hp<=0)killEnemy(e);
    }
  }

  // Q: alev üfleme
  if(ig.qLeft>0){
    ig.qLeft-=dt;
    const half=T.qAngle*Math.PI/360;
    for(const e of enemies){if(e.qCd>0)e.qCd-=dt}
    for(const e of [...enemies]){
      const dx=e.x-player.x,dy=e.y-player.y,d=Math.hypot(dx,dy);
      if(d-e.r>T.qLen)continue;
      let diff=Math.atan2(dy,dx)-player.facing;
      diff=Math.atan2(Math.sin(diff),Math.cos(diff));
      if(Math.abs(diff)>half+Math.asin(Math.min(1,e.r/Math.max(d,e.r))))continue;
      if(e.qCd>0)continue;
      e.qCd=T.qTick;
      e.hp-=T.qDmg;
      applyBurn(e);
      burst(e.x,e.y,"#fb923c",4);
      if(e.hp<=0){
        killEnemy(e);                                       // Q ile infaz: azami canın %10'u yenilenir
        player.hp=Math.min(player.maxHp,player.hp+player.maxHp*T.qHeal);
      }
    }
    if(Math.random()<.6){
      const a=player.facing+rand(-half,half),r=rand(12,T.qLen);
      burst(player.x+Math.cos(a)*r,player.y+Math.sin(a)*r,"#fb923c",1);
    }
    if(ig.qLeft<=0){ig.qLeft=0;cooldowns.q=clock/1000+T.qCd}
  }

  // W: yanan zemin
  if(ig.zone){
    const z=ig.zone;
    z.life-=dt;
    for(const e of enemies){if(e.zoneCd>0)e.zoneCd-=dt}
    for(const e of [...enemies]){
      if(Math.hypot(e.x-z.x,e.y-z.y)<z.r+e.r){
        e.slow=Math.max(e.slow,T.wSlowLinger);e.slowMul=1-T.wSlow;   // alandan çıkınca da süre boyunca yavaş kalır
        if(!(e.zoneCd>0)){
          e.zoneCd=T.wTick;
          e.hp-=T.wDmg;
          applyBurn(e);
          burst(e.x,e.y,"#fb923c",3);
          if(e.hp<=0)killEnemy(e);
        }
      }
    }
    if(z.life<=0)ig.zone=null;
  }

  // R: iç ateş aurası
  if(ig.rLeft>0){
    ig.rLeft-=dt;
    ig.rTick-=dt;
    const tick=ig.rTick<=0;
    if(tick)ig.rTick=T.rTick;
    for(const e of [...enemies]){
      if(Math.hypot(e.x-player.x,e.y-player.y)<T.rRadius+e.r){
        e.ultMark=true;                                     // aurada kalanlar da ulti etkisine girer
        e.slow=Math.max(e.slow,.3);e.slowMul=1-T.rSlow;
        if(tick){
          e.hp-=T.rDmg;
          applyBurn(e);
          burst(e.x,e.y,"#fb923c",3);
          if(e.hp<=0)killEnemy(e);
        }
      }
    }
    if(ig.rLeft<=0){ig.rLeft=0;endIgniteUlt()}
  }
}

