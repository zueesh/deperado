function spawnEnemy(){
  let side=Math.floor(Math.random()*4),x,y;
  if(side===0){x=rand(20,W-20);y=15}
  if(side===1){x=W-15;y=rand(20,H-20)}
  if(side===2){x=rand(20,W-20);y=H-15}
  if(side===3){x=15;y=rand(20,H-20)}
  // Hangi düşman çıkacak: ENEMY tablosundaki "chance" değerlerine göre
  let roll=Math.random(),acc=0,type="melee";
  for(const k in ENEMY){acc+=ENEMY[k].chance;if(roll<acc){type=k;break}}
  enemies.push(buildEnemy(type,x,y));
}

// Verilen türde, verilen yerde, o anki zamana göre güçlenmiş bir düşman kurar
function buildEnemy(type,x,y){
  let c=ENEMY[type];
  let scale=1+elapsed/SCALE.time;
  let speedScale=Math.min(c.speedCap||SCALE.speedCap,SCALE.speedStart+elapsed/SCALE.speedTime);
  let maxHp=c.hp*scale;
  if(type==="runner")maxHp=c.hp;                                   // Koşucu: zamanla can artmaz
  if(type==="ranged")maxHp=Math.min(maxHp,player.damage*c.maxHits);   // Menzilli: en fazla 2 vuruşluk can
  let e={
    x,y,type,
    r:c.r,
    maxHp,hp:maxHp,
    damage:c.dmg*Math.min(c.dmgCap||SCALE.dmgCap,scale),
    speed:c.speed*speedScale,
    attack:0,shot:rand(.5,1.5),slow:0,
    color:c.color
  };
  if(type==="bomber")e.blast=c.blast*Math.min(c.blastCap,scale);   // ölünce patlama hasarı
  return e;
}

// Seviye için gereken XP: 1. seviyede 5, her seviyede artar, 10. seviyede 55 olur ve sonra hep 55 kalır
function xpNeeded(lv){return lv>=10?55:Math.round(5+(lv-1)*50/9)}

function levelUp(){
  level++;
  needed=xpNeeded(level);
  const g=CHAR_BASE[player.char].perLevel;
  player.maxHp+=g.hp;
  player.hp=Math.min(player.maxHp,player.hp+g.heal);
  player.damage+=g.damage;
  player.attackSpeed=Math.min(player.asCap,player.attackSpeed+g.as);
  player.speed+=g.speed;
  player.armor+=g.armor;
  say("SEVİYE "+level+"! Can, hasar, hız ve zırh arttı.");
}

function burst(x,y,color,n=6){
  for(let i=0;i<n;i++)particles.push({
    x,y,vx:rand(-90,90),vy:rand(-90,90),
    life:rand(.2,.5),color
  });
}

function killEnemy(e){
  let i=enemies.indexOf(e);
  if(i<0)return;
  enemies.splice(i,1);
  if(player&&player.char==="truesun"&&tr){
    const now=clock/1000;
    for(const k of ["q","w","e"])cooldowns[k]=Math.max(now,(cooldowns[k]||now)-.4);
    cooldowns.r=Math.max(now,(cooldowns.r||now)-1);
  }
  if(target===e){target=null;goal.x=player.x;goal.y=player.y}   // hedef öldüyse olduğun yerde kal
  if(e.type!=="egg")kills++;
  xp+=(e.xpOverride!==undefined?e.xpOverride:(ENEMY[e.type]?ENEMY[e.type].xp:BOSS.xp))*(1+player.xpBonus);
  burst(e.x,e.y,e.color,9);
  if(e.type==="bomber")blasts.push({x:e.x,y:e.y,t:ENEMY.bomber.fuse,max:ENEMY.bomber.fuse,radius:ENEMY.bomber.blastR,damage:e.blast});
  while(xp>=needed){xp-=needed;levelUp()}
  if(e.type==="boss")onBossDefeated();
}

/* ---------- TRUESUN · IŞIĞIN ERMİŞİ ---------- */
function truesunMode(mode){
  if(!tr||tr.mode===mode)return;
  const T=TUNE.truesun,old=tr.mode;
  if(tr.chargeActive){tr.chargeActive=false;tr.charge=0;cooldowns.q=clock/1000+T.qCd}
  const oldD=old==="spear"?T.spearDamage:T.swordDamage,newD=mode==="spear"?T.spearDamage:T.swordDamage;
  const oldA=old==="spear"?T.spearAS:T.swordAS,newA=mode==="spear"?T.spearAS:T.swordAS;
  const oldS=old==="spear"?T.spearSpeed:T.swordSpeed,newS=mode==="spear"?T.spearSpeed:T.swordSpeed;
  player.damage*=newD/oldD;player.attackSpeed*=newA/oldA;player.speed*=newS/oldS;
  player.range=mode==="spear"?T.spearRange:T.swordRange;player.melee=mode==="sword";
  tr.mode=mode;tr.transition=T.wTime;tr.transitionFrom=old;
  burst(player.x,player.y,"#fde68a",18);rings.push({x:player.x,y:player.y,r:mode==="spear"?62:48,life:.55,color:"#fbbf24"});
  say(mode==="spear"?"İLAHİ MIZRAK · Uzak dövüş formu":"KUTSAL KILIÇ · Yakın dövüş formu");
}
function beginTruesunQ(){
  if(!player||player.char!=="truesun"||!playing||paused||gameOver||player.frozen>0||tr.mode!=="spear"||tr.transition>0||tr.chargeActive||(cooldowns.q||0)>clock/1000)return;
  if(bossRushMode)bossRushSource="Yetenek Q";tr.chargeActive=true;tr.charge=0;tr.fullHold=0;cooldowns.q=1e9;player.facing=Math.atan2(mouse.y-player.y,mouse.x-player.x);
  say("İlahi Mızrak güçleniyor! Bırak veya 4 sn dolmasını bekle.");
}
function releaseTruesunQ(){
  if(!tr||!tr.chargeActive)return;
  if(bossRushMode)bossRushSource="İlahi Mızrak";const T=TUNE.truesun,p=Math.min(1,tr.charge/T.qMax),dmg=T.qMinDmg+(T.qMaxDmg-T.qMinDmg)*p,len=T.qMinLen+(T.qMaxLen-T.qMinLen)*p;
  let ang=Math.atan2(mouse.y-player.y,mouse.x-player.x);if(!Number.isFinite(ang))ang=player.facing;
  player.facing=ang;tr.qShot={x:player.x+Math.cos(ang)*18,y:player.y+Math.sin(ang)*18,dx:Math.cos(ang),dy:Math.sin(ang),left:len,width:10+T.qWidth*p,damage:dmg,hit:new Set(),power:p};
  tr.chargeActive=false;tr.charge=0;tr.fullHold=0;cooldowns.q=clock/1000+T.qCd;
  burst(player.x+Math.cos(ang)*24,player.y+Math.sin(ang)*24,"#fef08a",24);say("İlahi Mızrak fırlatıldı!");
}
function placeTruesunField(pt){
  const T=TUNE.truesun;tr.field={x:pt.x,y:pt.y,left:T.eLife,tick:0};tr.aim=null;cooldowns.e=clock/1000+T.eCd;
  rings.push({x:pt.x,y:pt.y,r:T.eRadius,life:.55,color:"#fde68a"});burst(pt.x,pt.y,"#fef3c7",22);say("Işık Mabedi kuruldu!");
}
function launchTruesunUlt(pt){
  const T=TUNE.truesun,d=Math.hypot(pt.x-player.x,pt.y-player.y),travel=Math.max(.45,Math.min(2,d/420));
  tr.aim=null;tr.ult={phase:"flight",x:pt.x,y:pt.y,left:travel,max:travel};tr.arena=null;tr.empower=0;cooldowns.r=clock/1000+30;target=null;goal={x:player.x,y:player.y};
  say("Truesun göğe yükseliyor!");
