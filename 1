function renderNotes(){
  $("notesBody").innerHTML=PATCH_NOTES.map((p,i)=>{
    const secs=p.sections.map(sc=>
      '<div class="psec"><span class="dot" style="background:'+(sc.color||"#94a3b8")+'"></span>'+sc.who+'</div>'+
      sc.items.map(it=>'<div class="pitem '+it[0]+'"><span class="tag" title="'+TAGS[it[0]][1]+'">'+TAGS[it[0]][0]+'</span><span>'+it[1]+'</span></div>').join("")
    ).join("");
    return '<details class="patch"'+(i<2?" open":"")+'><summary>v'+p.v+'<span class="ptitle">'+p.title+'</span>'+(i===0?'<span class="latest">EN YENİ</span>':"")+'</summary><div class="pbody">'+secs+'</div></details>';
  }).join("");
}

function notesSeenVersion(){try{return localStorage.getItem("miniArenaNotesSeen")}catch(_){return null}}

function openNotes(){
  renderNotes();
  try{localStorage.setItem("miniArenaNotesSeen",VERSION)}catch(_){}
  $("notesBtn").classList.remove("hasNew");
  showScreen("notesScreen");
}

// Yeni sürümü henüz görmediysen düğmede YENİ rozeti yanar
$("notesBtn").classList.toggle("hasNew",notesSeenVersion()!==VERSION);

// Sayfa açılınca: arenayı hazırla, ama oyunu başlatma, menüyü göster
buildStatPanel();
buildSkillBar();
initGame();
draw();
updateUI(clock);
buildCharScreen();
$("charGrid").addEventListener("click",e=>{
  const i=e.target.closest(".infoBtn");
  if(i){showCharInfo(i.dataset.id);return}
  const b=e.target.closest(".charCard");
  if(b)selectChar(b.dataset.id);
});
showScreen("menu");

$("skills").addEventListener("click",e=>{
  const b=e.target.closest(".skill");
  if(b){if(player&&player.char==="truesun"&&b.dataset.k==="q"&&tr.mode==="spear"){if(tr.chargeActive)releaseTruesunQ();else beginTruesunQ()}else useSkill(b.dataset.k);}
});
canvas.addEventListener("pointermove",e=>{mouse=canvasPos(e)});
canvas.addEventListener("contextmenu",e=>e.preventDefault());
const releaseBeam=()=>{if(xo)xo.holding=false};
document.addEventListener("pointerup",releaseBeam);
document.addEventListener("pointercancel",releaseBeam);
// Azuron: Q tuşuna basılı tutarken nişan alınır, tıklamadan bırakırsan Q iptal olur
document.addEventListener("keyup",e=>{
  if(e.key.toLowerCase()==="q"&&tr&&player&&player.char==="truesun"&&tr.chargeActive){releaseTruesunQ();return}
  if(e.key.toLowerCase()==="q"&&az&&az.qHeld){
    az.qHeld=false;
    if(az.aim==="q"){cancelAimAz();say("Yıldırım iptal edildi.")}
  }
});
$("cardRow").addEventListener("click",e=>{
  const b=e.target.closest(".upgCard");
  if(b)chooseCard(+b.dataset.i);
});
fitScreen();
if(typeof window!=="undefined"){
  window.addEventListener("resize",fitScreen);
  window.addEventListener("orientationchange",fitScreen);
}
document.addEventListener("fullscreenchange",fitScreen);
</script>
