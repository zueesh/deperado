// Düşmanların altında: yanan zemin, ateş aurası, alev konisi
function drawIgnarUnder(){
  if(player.char!=="ignar")return;
  const T=TUNE.ignar;
  if(ig.zone){
    const z=ig.zone;
    ctx.globalAlpha=Math.min(1,z.life);
    ctx.fillStyle="rgba(249,115,22,.22)";
    ctx.beginPath();ctx.arc(z.x,z.y,z.r,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fb923c";ctx.lineWidth=3;ctx.setLineDash([6,5]);ctx.stroke();ctx.setLineDash([]);
    for(let i=0;i<5;i++){
      const a=i*1.26+clock/400,rr=z.r*.55;
      ctx.fillStyle="rgba(253,186,116,.55)";
      ctx.beginPath();ctx.arc(z.x+Math.cos(a)*rr,z.y+Math.sin(a)*rr,4+Math.sin(clock/120+i)*2,0,Math.PI*2);ctx.fill();
    }
    ctx.globalAlpha=1;
  }
  if(ig.rLeft>0){
    const pulse=1+Math.sin(clock/110)*.03;
    ctx.fillStyle="rgba(249,115,22,.14)";
    ctx.beginPath();ctx.arc(player.x,player.y,T.rRadius*pulse,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="rgba(251,146,60,.9)";ctx.lineWidth=3;ctx.stroke();
    ctx.strokeStyle="rgba(253,186,116,.4)";ctx.lineWidth=2;
    ctx.beginPath();ctx.arc(player.x,player.y,T.rRadius*.6*pulse,0,Math.PI*2);ctx.stroke();
  }
  if(ig.qLeft>0){
    const half=T.qAngle*Math.PI/360,f=player.facing;
    for(const [k,al,col] of [[1,.25,"#fb923c"],[.75,.3,"#fdba74"],[.5,.4,"#fde68a"]]){
      const len=T.qLen*k*(1+Math.sin(clock/60+k*5)*.04);
      ctx.globalAlpha=al;ctx.fillStyle=col;
      ctx.beginPath();ctx.moveTo(player.x,player.y);ctx.arc(player.x,player.y,len,f-half,f+half);ctx.closePath();ctx.fill();
    }
    ctx.globalAlpha=1;
  }
}

// Düşmanların üstünde: yanma işaretleri, ateş topları, nişan önizlemesi
function drawIgnar(){
  if(player.char!=="ignar")return;
  const T=TUNE.ignar;
  for(const e of enemies){
    if(e.burn&&e.burn.length){
      const n=e.burn.length;
      for(let i=0;i<Math.min(n,3);i++){
        const ox=(i-1)*5+Math.sin(clock/90+e.x+i)*1.5,oy=-e.r-5-Math.abs(Math.sin(clock/110+i))*3;
        ctx.fillStyle=i%2?"#fde68a":"#fb923c";
        ctx.beginPath();ctx.arc(e.x+ox,e.y+oy,3.2,0,Math.PI*2);ctx.fill();
      }
      if(n>1){
        ctx.fillStyle="#fff7ed";ctx.font="bold 11px Arial";ctx.textAlign="center";
        ctx.fillText("x"+n,e.x,e.y-e.r-15);
        ctx.textAlign="left";
      }
    }
  }
  for(const f of flames){
    const r=f.kind==="empower"?9:5;
    const col=f.kind==="empower"?"#fcd34d":"#fb923c";
    ctx.globalAlpha=.35;ctx.fillStyle=col;
    ctx.beginPath();ctx.arc(f.x,f.y,r+4,0,Math.PI*2);ctx.fill();
    ctx.globalAlpha=1;ctx.fillStyle=col;
    ctx.beginPath();ctx.arc(f.x,f.y,r,0,Math.PI*2);ctx.fill();
    ctx.fillStyle="#fff7ed";ctx.beginPath();ctx.arc(f.x,f.y,r*.4,0,Math.PI*2);ctx.fill();
  }
  if(ig.eArmed){
    ctx.strokeStyle="#fcd34d";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(player.x,player.y,player.r+6,0,Math.PI*2);ctx.stroke();
  }
  if(ig.aiming){
    ctx.strokeStyle="rgba(251,146,60,.6)";ctx.lineWidth=2;ctx.setLineDash([8,6]);
    ctx.beginPath();ctx.arc(player.x,player.y,T.wRange,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
    const p=clampZone(mouse.x,mouse.y);
    ctx.globalAlpha=.55;
    ctx.fillStyle="rgba(249,115,22,.35)";ctx.beginPath();ctx.arc(p.x,p.y,T.wRadius,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fb923c";ctx.lineWidth=3;ctx.stroke();
    ctx.globalAlpha=1;
  }
}

/* ---------- GENERAL MEDA ---------- */
// Yetenek hasarı = atak hasarı × oran. 1. seviyede söylenen rakamı verir, seviye atladıkça atak hasarıyla birlikte büyür.
function mdmg(ratio){return player.damage*ratio}

function cancelAimMe(){
  if(me)me.aim=null;
  canvas.classList.remove("aiming");
  canvas.classList.remove("aimingYellow");
  canvas.classList.remove("aimingRed");
}

// Noktayı oyuncudan "range" uzaklığa ve harita içine sınırlar
function clampMe(x,y,range,margin){
  let dx=x-player.x,dy=y-player.y;
  const d=Math.hypot(dx,dy);
  if(d>range){dx=dx/d*range;dy=dy/d*range}
  return{x:Math.max(margin,Math.min(W-margin,player.x+dx)),y:Math.max(margin,Math.min(H-margin,player.y+dy))};
}

function aimAngle(from,to){
  if(Math.hypot(to.x-from.x,to.y-from.y)<8)return player.facing;
  return Math.atan2(to.y-from.y,to.x-from.x);
}

// Hava saldırısındaki bombaların merkezleri: ilk bombanın dairesi başlangıç noktasına, sonuncusu hattın sonuna değer
function strikePoints(start,ang){
  const T=TUNE.meda,n=T.rBombs;
  const first=T.rRadius,last=T.rLen-T.rRadius;
  const pts=[];
  for(let i=0;i<n;i++){
    const dd=first+(last-first)*(n===1?0:i/(n-1));
    pts.push({x:Math.max(10,Math.min(W-10,start.x+Math.cos(ang)*dd)),y:Math.max(10,Math.min(H-10,start.y+Math.sin(ang)*dd))});
  }
  return pts;
}

function launchStrike(start,ang){
  const T=TUNE.meda;
  strikePoints(start,ang).forEach((q,i)=>{
    me.bombs.push({x:q.x,y:q.y,wait:i*T.rGap,fall:T.rFall,phase:"wait"});
  });
  cooldowns.r=clock/1000+T.rCd;
  cancelAimMe();
  say("Hava saldırısı geliyor!");
}

function placeFlare(p){
  const T=TUNE.meda,q=clampMe(p.x,p.y,T.eRange,10);
  me.flare={x:q.x,y:q.y,left:T.eDur};
  cooldowns.e=1e9;                                       // bekleme fişek patlayınca başlar
  cancelAimMe();
  rings.push({x:q.x,y:q.y,r:30,life:.3,color:"#fde047"});
  burst(q.x,q.y,"#fde047",14);
  say("İşaret fişeği atıldı! Düşmanlar ona saldırıyor, "+T.eDur+" sn sonra patlayacak.");
}

function knockback(e){
  const T=TUNE.meda;
  let dx=e.x-player.x,dy=e.y-player.y;
  const d=Math.hypot(dx,dy)||1;
  e.knock={vx:dx/d*T.knockDist/T.knockTime,vy:dy/d*T.knockDist/T.knockTime,t:T.knockTime};
}

function fireBullet(e){
  if(!enemies.includes(e))return;
  const T=TUNE.meda;
  me.shots++;
  bullets.push({x:player.x+Math.cos(player.facing)*16,y:player.y+Math.sin(player.facing)*16,
    target:e,tx:e.x,ty:e.y,speed:T.bulletSpeed,damage:player.damage,kind:"bullet",knock:me.shots%T.knockEvery===0});
}

function bulletImpact(b){
  const e=b.target,T=TUNE.meda;
  e.hp-=b.damage;
  burst(e.x,e.y,b.kind==="drone"?"#bef264":"#fde047",b.knock?7:3);
  if(e.hp<=0){
    killEnemy(e);
    if(b.kind==="drone"&&me.drone)me.drone.left+=T.qExtend;   // dron öldürürse süresi uzar
  }else if(b.knock)knockback(e);
}

function useMedaSkill(key,now){
  const T=TUNE.meda;
  const ready=(cooldowns[key]||0)<=now;
  if(key==="q"){
    cancelAimMe();
    if(me.drone||!ready)return;
    me.drone={x:player.x,y:player.y-20,left:T.qDur,cd:.2};
    cooldowns.q=1e9;                                   // bekleme dron kaybolunca başlar
    rings.push({x:player.x,y:player.y,r:40,life:.3,color:"#bef264"});
    say("Dost dron devrede! "+T.qDur+" sn boyunca seni takip edip ateş eder.");
  }
  if(key==="w"){
    cancelAimMe();
    if(!ready)return;
    me.box={x:player.x,y:player.y,left:T.wDur,tick:T.wTick};
    cooldowns.w=now+T.wCd;
    rings.push({x:player.x,y:player.y,r:T.wRadius,life:.3,color:"#86efac"});
    say("Sağlık kutusu atıldı! İçinde durdukça canın yenilenir.");
  }
  if(key==="e"){
    if(me.aim==="flare"){cancelAimMe();say("Nişan iptal edildi.");return}
    cancelAimMe();
    if(!ready||me.flare)return;
    me.aim="flare";
    canvas.classList.add("aiming");
    canvas.classList.add("aimingYellow");
    say("Fişeği atacağın noktaya tıkla (iptal: E / Esc / sağ tık)");
  }
  if(key==="r"){
    if(me.aim==="rstart"||me.aim==="rdir"){cancelAimMe();say("Nişan iptal edildi.");return}
    cancelAimMe();
    if(!ready)return;
    me.aim="rstart";
    canvas.classList.add("aiming");
    canvas.classList.add("aimingRed");
    say("Saldırının başlayacağı noktaya tıkla, sonra yönü seç (iptal: R / Esc / sağ tık)");
  }
}

function updateMeda(dt,now){
  const T=TUNE.meda;

  // mermiler (hedefi takip eder)
  for(const b of [...bullets]){
    if(b.target&&enemies.includes(b.target)){b.tx=b.target.x;b.ty=b.target.y}
    else{bullets.splice(bullets.indexOf(b),1);continue}
    const dx=b.tx-b.x,dy=b.ty-b.y,d=Math.hypot(dx,dy),step=b.speed*dt;
    if(d<step+6){bulletImpact(b);bullets.splice(bullets.indexOf(b),1)}
    else{b.x+=dx/d*step;b.y+=dy/d*step}
  }

  // Q: dost dron
  if(me.drone){
    const dr=me.drone;
    dr.left-=dt;
    const ang=clock/600;
    const tx=player.x+Math.cos(ang)*24-10,ty=player.y-28+Math.sin(ang*1.7)*5;
    dr.x+=(tx-dr.x)*Math.min(1,dt*7);
    dr.y+=(ty-dr.y)*Math.min(1,dt*7);
    dr.cd-=dt;
    if(dr.cd<=0){
      let best=null,bd=1e9;
      for(const e of enemies){
        const dd=Math.hypot(e.x-dr.x,e.y-dr.y)-e.r;
        if(dd<=T.droneRange&&dd<bd){bd=dd;best=e}
      }
      if(best){
        dr.cd=1/T.droneAs;
        bullets.push({x:dr.x,y:dr.y,target:best,tx:best.x,ty:best.y,speed:T.bulletSpeed*1.2,damage:mdmg(T.droneDmgRatio),kind:"drone",knock:false});
      }else dr.cd=0;
    }
    if(dr.left<=0){me.drone=null;cooldowns.q=clock/1000+T.qCd}
  }

  // W: sağlık kutusu
  if(me.box){
    const bx=me.box;
    bx.left-=dt;
    if(Math.hypot(player.x-bx.x,player.y-bx.y)<T.wRadius){
      bx.tick-=dt;
      if(bx.tick<=0){
        bx.tick+=T.wTick;
        player.hp=Math.min(player.maxHp,player.hp+player.maxHp*T.wHeal);
        burst(player.x,player.y,"#86efac",8);
      }
    }
    for(const e of enemies){
      if(Math.hypot(e.x-bx.x,e.y-bx.y)<T.wRadius+e.r){e.slow=Math.max(e.slow,.25);e.slowMul=1-T.wSlow}
    }
    if(bx.left<=0)me.box=null;
  }

  // E: işaret fişeği (süre bitince patlar)
  if(me.flare){
    const f=me.flare;
    f.left-=dt;
    if(f.left<=0){
      me.flare=null;
      cooldowns.e=clock/1000+T.eCd;
      const dmg=mdmg(T.eDmgRatio);
      rings.push({x:f.x,y:f.y,r:T.eRadius,life:.35,color:"#fde047"});
      burst(f.x,f.y,"#fbbf24",30);
      for(const e of [...enemies]){
        if(Math.hypot(e.x-f.x,e.y-f.y)<T.eRadius+e.r){e.hp-=dmg;if(e.hp<=0)killEnemy(e)}
      }
    }
  }

  // R: hava saldırısı bombaları
  for(const b of [...me.bombs]){
    if(b.phase==="wait"){b.wait-=dt;if(b.wait<=0)b.phase="fall";else continue}
    b.fall-=dt;
    if(b.fall<=0){
      me.bombs.splice(me.bombs.indexOf(b),1);
      const dmg=mdmg(T.rDmgRatio);
      rings.push({x:b.x,y:b.y,r:T.rRadius,life:.3,color:"#f87171"});
      burst(b.x,b.y,"#fb923c",18);
      for(const e of [...enemies]){
        if(Math.hypot(e.x-b.x,e.y-b.y)<T.rRadius+e.r){e.hp-=dmg;if(e.hp<=0)killEnemy(e)}
      }
    }
  }
}

