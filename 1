function playerHit(dmg){
  if(bossRushMode&&bossRushStats)bossRushStats.damageTaken+=Math.max(1,dmg-player.armor);
  if(ah)ah.calm=0;                                    // hasar yedin: Arhas'ın pasif sayacı sıfırlanır
  const raw=Math.max(1,dmg-player.armor);
  let taken=raw,heal=0;
  if(player.char==="xort"){
    const T=TUNE.xort;
    if(xo.ultOn||xo.wLeft>0)taken=raw*(1-T.reduce);   // W ve ulti aynı azaltmayı verir, birikmez
    if(xo.wLeft>0)xo.wStored+=raw*T.wStoreMul;                     // W: yediği (azaltılmamış) hasar birikir, W bitince geri yüklenir
  }
  player.hp=Math.min(player.maxHp,player.hp-taken+heal);
  burst(player.x,player.y,"#f87171",3);
  if(player.hp<=0){
    player.hp=0;gameOver=true;playing=false;target=null;
    if(totalTime>best)best=totalTime;
    say("OYUN BİTTİ! "+Math.floor(totalTime)+" saniye hayatta kaldın.");
    if(bossRushMode)setTimeout(()=>finishBossRush(false),250);else setTimeout(showOver,900);
  }
}

function update(dt,now){
  if(gameOver)return;
  totalTime+=dt;                                  // toplam süre: hiç durmaz
  if(!bossState.boss)elapsed+=dt;                 // boss sayacı: boss varken durur, boss ölünce kaldığı yerden devam eder
  if(!bossState.boss&&bossState.rewardIn<=0&&!bossState.offer&&elapsed>=bossState.next)startBoss();
  updateThemes(dt);
  if(player.regen>0)player.hp=Math.min(player.maxHp,player.hp+player.regen*dt);          // güçlenme: can yenileme
  if(player.cdr>0){                                                                     // güçlenme: bekleme süresi kısalması
    const extra=dt*player.cdr/(1-player.cdr);
    for(const k in cooldowns)if(cooldowns[k]>now/1000)cooldowns[k]-=extra;
  }
  const t=now/1000;
  const ult=t<ultEnd;
  if(player.char==="eron"&&eronUltOn&&!ult){cooldowns.r=t+TUNE.eron.rCd;eronUltOn=false}   // ulti bitti: bekleme başlar

  if(target&&!enemies.includes(target)){target=null;goal.x=player.x;goal.y=player.y}   // hedef öldüyse olduğun yerde kal
  if(target){goal.x=target.x;goal.y=target.y}

  if(player.char==="arhas"&&ah.channel>0){goal.x=player.x;goal.y=player.y;target=null}   // Skaruun için odaklanırken yerinde durur
  if(player.char==="xort"&&xo.ultOn){goal.x=player.x;goal.y=player.y;target=null}   // lazer formunda yere sabitlenir
  let d=Math.hypot(goal.x-player.x,goal.y-player.y);
  if(target&&d<=player.range+(player.melee?target.r:0)&&!(player.char==="truesun"&&tr.transition>0)){   // yakın dövüşçüde menzil, hedefin yarıçapına eklenir
    player.facing=Math.atan2(target.y-player.y,target.x-player.x);
    let as=Math.min(player.asCap,player.attackSpeed*(ult?TUNE.eron.rAs:1));
    if(now-lastShot>=1000/as){
      if(bossRushMode)bossRushSource="Temel saldırı";
      if(player.char==="eron")shoot(target,ult);else if(player.char==="truesun")fireTruesunAuto(target);else if(player.char==="xort")firePlasma(target);else if(player.char==="ignar")fireFlame(target);else if(player.char==="meda")fireBullet(target);else if(player.char==="azuron")fireZap(target);else if(player.char==="arhas")punch(target);else fireLaser(target);
      lastShot=now;
    }
  }else if(d>4&&!(player.rooted>0||player.kb)){   // ağa yapışmışken ya da fırlatılırken yürüyemez
    let speed=player.speed*(ult?TUNE.eron.rSpeed:1)*(player.char==="vyron"&&vy.w?1-TUNE.vyron.wSelfSlow:1)*(player.onIce?1-MAPFX.iceSlow:1);   // Vyron'un W'si seni yavaşlatır
    player.x+=(goal.x-player.x)/d*speed*dt;
    player.y+=(goal.y-player.y)/d*speed*dt;
    player.facing=Math.atan2(goal.y-player.y,goal.x-player.x);
  }

  spawnTimer-=dt;
  if(spawnTimer<=0&&!bossState.boss){   // boss varken yeni düşman doğmaz
    spawnEnemy();
    if(elapsed>SCALE.doubleAfter&&Math.random()<SCALE.doubleChance)spawnEnemy();
    spawnTimer=Math.max(SCALE.spawnMin,SCALE.spawnStart-elapsed*SCALE.spawnDrop);
  }

  for(let e of [...enemies]){
    if(e.type==="boss"||e.type==="egg")continue;      // boss kendi yapay zekasını kullanır, yumurta yerinde durur
    e.slow=Math.max(0,e.slow-dt);
    e.attack-=dt;e.shot-=dt;
    if(e.type==="poison"){
      // Ölene kadar, yürüdüğü yere her ~10 pikselde bir zehir bırakır (5 sn kalır)
      if(e.lx===undefined||Math.hypot(e.x-e.lx,e.y-e.ly)>=10){
        puddles.push({x:e.x,y:e.y,r:ENEMY.poison.puddleR,life:ENEMY.poison.puddleLife});
        e.lx=e.x;e.ly=e.y;
      }
    }
    if(e.knock){                        // geri püskürtme (kısa süreli kayma)
      e.x=Math.max(0,Math.min(W,e.x+e.knock.vx*dt));
      e.y=Math.max(0,Math.min(H,e.y+e.knock.vy*dt));
      e.knock.t-=dt;
      if(e.knock.t<=0)e.knock=null;
    }
    if(e.stun>0){e.stun-=dt;continue}   // hareketsiz: yürüyemez, saldıramaz
    // General Meda'nın işaret fişeği varsa tüm düşmanlar ona yönelir, oyuncuya saldırmaz
    const flare=(player.char==="meda"&&me.flare)?me.flare:null;
    let tgt=flare||player;
    let tgtR=flare?TUNE.meda.flareR:player.r;
    const ally=(ah&&ah.ally&&!flare&&ah.ally.emerge<=0)?ah.ally:null;           // Arhas'ın dostu: düşmanlar kime daha yakınsa ona saldırır
    if(ally&&Math.hypot(e.x-ally.x,e.y-ally.y)<Math.hypot(e.x-player.x,e.y-player.y)){tgt=ally;tgtR=ally.r}
    let d=dist(e,tgt);
    if(e.rage>0)e.rage-=dt;
    if(fx.theme==="rage"&&fx.phase==="active"&&inPools(e.x,e.y,"rage"))e.rage=MAPFX.rageLinger;   // iksire değen düşman öfkelenir
    const rm=e.rage>0?MAPFX.rageMul:1;                                                             // 1.4 kat hız ve hasar
    let speed=e.speed*rm*(e.slow>0?(e.slowMul||.45):1)*windFactor();                               // tersine esinti: %15 yavaşlık

    if(e.type==="ranged"){
      if(d>ENEMY.ranged.keepDist){
        e.x+=(tgt.x-e.x)/d*speed*dt;
        e.y+=(tgt.y-e.y)/d*speed*dt;
      }
      if(d<ENEMY.ranged.shootRange&&e.shot<=0){
        // Mermi hedefin o anki konumuna nişan alır.
        // Ateş edildikten sonra hedefi takip etmez. Fişeğe atılan oklar oyuncuya zarar vermez.
        let dx=tgt.x-e.x,dy=tgt.y-e.y;
        let len=Math.hypot(dx,dy)||1;
        arrows.push({
          x:e.x,y:e.y,vx:dx/len*ENEMY.ranged.bulletSpeed,vy:dy/len*ENEMY.ranged.bulletSpeed,
          damage:e.damage*rm,enemy:true,life:flare?len/ENEMY.ranged.bulletSpeed:3,decoy:!!flare,toAlly:!!ally&&tgt===ally
        });
        e.shot=ENEMY.ranged.shootEvery;
      }
    }else if(d>e.r+tgtR+3){
      e.x+=(tgt.x-e.x)/d*speed*dt;
      e.y+=(tgt.y-e.y)/d*speed*dt;
    }else if(e.attack<=0&&!flare){
      if(ally&&tgt===ally)allyHit(e.damage*rm);else playerHit(e.damage*rm);
      e.attack=1;
    }
  }

  for(let m of [...mines]){
    m.life-=dt;
    for(let e of [...enemies]){
      if(dist(m,e)<m.r+e.r){
        burst(m.x,m.y,"#fbbf24",20);
        rings.push({x:m.x,y:m.y,r:TUNE.eron.mineRadius,life:.3,color:"#fbbf24"});
        for(let v of [...enemies]){                       // mayın patlar: alandaki herkese hasar (öldürmez, hasar verir)
          if(dist(m,v)<TUNE.eron.mineRadius+v.r){v.hp-=TUNE.eron.mineDmg;if(v.hp<=0)killEnemy(v)}
        }
        m.life=0;
        break;
      }
    }
    if(m.life<=0)mines.splice(mines.indexOf(m),1);
  }

  for(let a of [...arrows]){
    if(a.enemy){
      a.x+=a.vx*dt;
      a.y+=a.vy*dt;
      a.life-=dt;
      if(a.toAlly&&ah&&ah.ally&&Math.hypot(ah.ally.x-a.x,ah.ally.y-a.y)<ah.ally.r+5){
        allyHit(a.damage);
        arrows.splice(arrows.indexOf(a),1);
      }else if(!a.decoy&&!a.toAlly&&Math.hypot(player.x-a.x,player.y-a.y)<player.r+5){
        playerHit(a.damage);
        arrows.splice(arrows.indexOf(a),1);
      }else if(a.life<=0||a.x<0||a.x>W||a.y<0||a.y>H){
        arrows.splice(arrows.indexOf(a),1);
      }
      continue;
    }

    if(!a.target||!enemies.includes(a.target)){
      arrows.splice(arrows.indexOf(a),1);
      continue;
    }

    let dx=a.target.x-a.x,dy=a.target.y-a.y;
    let d=Math.hypot(dx,dy),step=a.speed*dt;

    if(d<step+9){
      if(a.aoe){
        let cx=a.target.x,cy=a.target.y;
        for(let e of [...enemies]){
          if(Math.hypot(e.x-cx,e.y-cy)<a.radius+e.r){
            e.hp-=a.damage;
            if(e===a.target)e.stun=TUNE.eron.eStun;                                    // doğrudan vurulan hareketsiz kalır
            else{e.slow=TUNE.eron.eSlow;e.slowMul=1-TUNE.eron.eSlowPct}                // alandakiler yavaşlar
            burst(e.x,e.y,"#fde68a",4);
            if(e.hp<=0)killEnemy(e);
            if(ult)player.hp=Math.min(player.maxHp,player.hp+a.damage*TUNE.eron.rSteal);
          }
        }
      }else{
        let hit=a.target;
        hit.hp-=a.damage;
        if(ult)player.hp=Math.min(player.maxHp,player.hp+a.damage*TUNE.eron.rSteal);
        if(hit.hp<=0)killEnemy(hit);

        if(ult){
          for(let e of enemies){
            if(dist(e,hit)<e.r+hit.r+22){
              let n=Math.hypot(e.x-player.x,e.y-player.y)||1;
              e.x+=(e.x-player.x)/n*24;
              e.y+=(e.y-player.y)/n*24;
            }
          }
        }
      }
      if(a.heal)player.hp=Math.min(player.maxHp,player.hp+player.maxHp*TUNE.eron.healFrac);
      arrows.splice(arrows.indexOf(a),1);
    }else{
      a.x+=dx/d*step;a.y+=dy/d*step;
    }
  }

  updateBoss(dt);
  if(player.char==="vyron")updateVyron(dt,now);
  if(player.char==="xort")updateXort(dt,now);
  if(player.char==="ignar")updateIgnar(dt,now);
  if(player.char==="meda")updateMeda(dt,now);
  if(player.char==="azuron")updateAzuron(dt);
  if(player.char==="arhas")updateArhas(dt);
  if(player.char==="truesun")updateTruesun(dt,now);

  for(let b of [...blasts]){
    b.t-=dt;
    if(b.t<=0){
      blasts.splice(blasts.indexOf(b),1);
      rings.push({x:b.x,y:b.y,r:b.radius,life:.3});
      burst(b.x,b.y,"#fb923c",28);
      if(Math.hypot(player.x-b.x,player.y-b.y)<b.radius+player.r)playerHit(b.damage);
    }
  }

  for(let z of [...puddles]){
    z.life-=dt;
    if(z.life<=0)puddles.splice(puddles.indexOf(z),1);
  }
  poisonTick-=dt;
  let inPoison=puddles.some(z=>Math.hypot(player.x-z.x,player.y-z.y)<z.r+player.r*.6);
  if(inPoison&&poisonTick<=0){playerHit(ENEMY.poison.puddleDmg);poisonTick=ENEMY.poison.puddleTick}

  for(let g of [...rings]){
    g.life-=dt;
    if(g.life<=0)rings.splice(rings.indexOf(g),1);
  }

  for(let p of [...particles]){
    p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;
    if(p.life<=0)particles.splice(particles.indexOf(p),1);
  }
}

function shoot(e,ult){
  if(!enemies.includes(e))return;
  let aoe=empowered;
  player.shots=(player.shots||0)+1;
  const heal=player.shots%TUNE.eron.healEvery===0;   // pasif: her 3. ok can yeniler
  arrows.push({
    x:player.x+Math.cos(player.facing)*15,
    y:player.y+Math.sin(player.facing)*15,
    target:e,speed:460,
    damage:player.damage*(ult?TUNE.eron.rDmg:1),
    enemy:false,aoe,radius:aoe?TUNE.eron.eRadius:0,heal
  });
  if(aoe){empowered=false;burst(player.x,player.y,"#facc15",8)}
}

function draw(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle="#182b2b";ctx.fillRect(0,0,W,H);
  ctx.strokeStyle="rgba(148,163,184,.12)";ctx.lineWidth=1;

  for(let x=0;x<W;x+=40){
    ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();
  }
  for(let y=0;y<H;y+=40){
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
  }

  ctx.strokeStyle="#526565";ctx.lineWidth=5;
  ctx.strokeRect(3,3,W-6,H-6);

  if(!gameOver&&!target&&Math.hypot(goal.x-player.x,goal.y-player.y)>6){
    ctx.strokeStyle="#e2e8f0";ctx.setLineDash([5,6]);
    ctx.beginPath();ctx.moveTo(player.x,player.y);ctx.lineTo(goal.x,goal.y);ctx.stroke();
    ctx.setLineDash([]);
    ctx.beginPath();ctx.arc(goal.x,goal.y,7,0,Math.PI*2);ctx.stroke();
  }

  drawThemes();

  for(let z of puddles){
    ctx.globalAlpha=Math.min(1,z.life)*.45;
    ctx.fillStyle="#84cc16";ctx.beginPath();ctx.arc(z.x,z.y,z.r,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#bef264";ctx.lineWidth=2;ctx.stroke();
  }
  ctx.globalAlpha=1;

  for(let b of blasts){
    let p=1-b.t/b.max;
    ctx.fillStyle="rgba(239,68,68,"+(.12+p*.25)+")";
    ctx.beginPath();ctx.arc(b.x,b.y,b.radius,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fb923c";ctx.lineWidth=3;ctx.setLineDash([8,6]);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle="rgba(251,146,60,.5)";
    ctx.beginPath();ctx.arc(b.x,b.y,b.radius*p,0,Math.PI*2);ctx.fill();
  }

  for(let m of mines){
    ctx.fillStyle="#fbbf24";ctx.beginPath();ctx.arc(m.x,m.y,m.r,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fff7ae";ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle="#78350f";ctx.fillRect(m.x-4,m.y-4,8,8);
  }

  drawVyronUnder();
  drawIgnarUnder();
  drawMedaUnder();
  if(player.char==="truesun")drawTruesunUnder();

  for(let e of enemies){
    if(e.type==="boss")continue;      // boss ayrı çizilir
    if(e.spider)drawSpiderBody(e);
    else if(e.type==="egg")drawEggBody(e);
    else{ctx.fillStyle=e.color;ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,Math.PI*2);ctx.fill()}
    if(e.type==="tank"){ctx.strokeStyle="#cbd5e1";ctx.lineWidth=3;ctx.stroke()}
    if(e.type==="bomber"){
      ctx.fillStyle="#7c2d12";ctx.beginPath();ctx.arc(e.x,e.y,e.r*.5,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle="#fde68a";ctx.lineWidth=2;
      ctx.beginPath();ctx.moveTo(e.x,e.y-e.r);ctx.lineTo(e.x+5,e.y-e.r-7);ctx.stroke();
    }
    if(e.type==="runner"){
      ctx.fillStyle="#fbcfe8";ctx.beginPath();ctx.arc(e.x,e.y,e.r*.4,0,Math.PI*2);ctx.fill();
    }
    if(e.type==="poison"){
      ctx.fillStyle="#365314";
      ctx.beginPath();ctx.arc(e.x-4,e.y-2,3,0,Math.PI*2);ctx.fill();
      ctx.beginPath();ctx.arc(e.x+4,e.y+3,2.5,0,Math.PI*2);ctx.fill();
    }
    if(e===target){
      ctx.strokeStyle="#fef08a";ctx.lineWidth=3;
      ctx.beginPath();ctx.arc(e.x,e.y,e.r+6,0,Math.PI*2);ctx.stroke();
    }
    ctx.fillStyle="#450a0a";ctx.fillRect(e.x-e.r,e.y-e.r-9,e.r*2,4);
    ctx.fillStyle="#4ade80";
    ctx.fillRect(e.x-e.r,e.y-e.r-9,e.r*2*Math.max(0,e.hp/e.maxHp),4);
    if(e.type==="ranged"){
      ctx.fillStyle="white";ctx.beginPath();ctx.arc(e.x,e.y,3,0,Math.PI*2);ctx.fill();
    }
    if(e.slow>0){
      ctx.strokeStyle="#67e8f9";ctx.beginPath();ctx.arc(e.x,e.y,e.r+3,0,Math.PI*2);ctx.stroke();
    }
    if(e.rage>0){
      ctx.strokeStyle="rgba(244,63,94,"+(.55+Math.sin(clock/80)*.25)+")";ctx.lineWidth=3;
      ctx.beginPath();ctx.arc(e.x,e.y,e.r+4,0,Math.PI*2);ctx.stroke();
    }
    if(e.stun>0){
      ctx.strokeStyle="#fde047";ctx.lineWidth=3;ctx.setLineDash([4,4]);
      ctx.beginPath();ctx.arc(e.x,e.y,e.r+6,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
    }
  }

  drawBoss();
  drawThemesOver();
  drawVyronOver();
  drawXort();
  drawIgnar();
  drawMeda();
  drawAzuron();
  drawArhas();
  if(player.char==="truesun")drawTruesunOver();

  let ult=clock/1000<ultEnd;
  if(ult){
    ctx.strokeStyle="#e879f9";ctx.lineWidth=4;
    ctx.beginPath();ctx.arc(player.x,player.y,player.r+9,0,Math.PI*2);ctx.stroke();
  }

  const trFlying=player.char==="truesun"&&tr.ult&&tr.ult.phase==="flight";
  if(!trFlying){
    if(player.char==="truesun"){
      ctx.save();ctx.shadowBlur=tr.transition>0?36:18;ctx.shadowColor="#fbbf24";ctx.fillStyle="#fef3c7";ctx.beginPath();ctx.arc(player.x,player.y,player.r+1,0,Math.PI*2);ctx.fill();ctx.restore();
      ctx.strokeStyle="#f59e0b";ctx.lineWidth=3;ctx.beginPath();ctx.arc(player.x,player.y,player.r+3,0,Math.PI*2);ctx.stroke();
    }else{ctx.fillStyle=selectedChar.color;ctx.beginPath();ctx.arc(player.x,player.y,player.r,0,Math.PI*2);ctx.fill();}
    ctx.strokeStyle="#713f12";ctx.lineWidth=2;ctx.stroke();
    if(player.char==="truesun")drawTruesunBody();
    if(player.char==="truesun")drawTruesunWeapon();
  }
  else if(player.char==="vyron")drawGun();
  else if(player.char==="xort")drawCannon();
  else if(player.char==="ignar")drawIgnarHand();
  else if(player.char==="meda")drawMedaHand();
  else if(player.char==="azuron")drawAzuronHand();
  else if(player.char==="arhas")drawArhasHand();
  else{
  let bx=player.x+Math.cos(player.facing)*13;
  let by=player.y+Math.sin(player.facing)*13;
  ctx.save();ctx.translate(bx,by);ctx.rotate(player.facing);
  ctx.strokeStyle="#92400e";ctx.lineWidth=3;
  ctx.beginPath();ctx.arc(0,0,9,-Math.PI/2,Math.PI/2);ctx.stroke();
  ctx.strokeStyle="#fef3c7";ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(0,-9);ctx.lineTo(0,9);ctx.stroke();
  ctx.restore();}

  for(let a of arrows){
    ctx.strokeStyle=a.enemy?"#f87171":a.aoe?"#fde047":"#e5e7eb";
    ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(a.x,a.y);
    ctx.lineTo(a.x-9,a.y-4);ctx.stroke();
  }

  for(let g of rings){
    ctx.globalAlpha=Math.max(0,g.life/.3)*.7;
    ctx.fillStyle=g.color||"#fdba74";ctx.beginPath();ctx.arc(g.x,g.y,g.r,0,Math.PI*2);ctx.fill();
  }
  ctx.globalAlpha=1;

  for(let p of particles){
    ctx.globalAlpha=Math.max(0,p.life*2);
    ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,4,4);
  }
  ctx.globalAlpha=1;

  drawFrozen();

  // Ölünce arena kırmızıya boyanır, kısa süre sonra menü açılır
  if(gameOver){
    ctx.fillStyle="rgba(127,29,29,.45)";ctx.fillRect(0,0,W,H);
  }
}

function updateUI(now){
  $("health").textContent=Math.ceil(player.hp)+"/"+Math.ceil(player.maxHp);
  const hpPct=(100*player.hp/player.maxHp)+"%";
  $("hp").style.width=hpPct;
  $("hpTrail").style.width=hpPct;                       // sarı iz: aldığın hasar yavaşça erir
  const lowHp=player.hp/player.maxHp<.3;
  $("hpBar").classList.toggle("low",lowHp);             // can azalınca bar ve kalp titrer
  $("heart").classList.toggle("low",lowHp);
  $("kills").textContent=kills;
  updateClocks();
  $("level").textContent="Sv "+level;
  $("xptext").textContent=Math.floor(xp)+" / "+needed+" XP";
  $("xp").style.width=(100*xp/needed)+"%";

  for(const [k] of SKILLS[player.char]){
    const b=$(k);
    if(!b)continue;
    const name=SKILLS[player.char].find(x=>x[0]===k)[1];
    const remain=Math.max(0,cooldowns[k]-now/1000);
    const st=skillState(k,remain);
    b.disabled=st.disabled||gameOver||!playing||paused;
    b.classList.toggle("on",!!st.on);
    const html='<span class="key">'+k.toUpperCase()+'</span><span class="nm">'+name+'</span><span class="st">'+compactStatus(st,remain)+'</span>';
    if(b._h!==html){b.innerHTML=html;b._h=html}
    b.title=st.text;
  }

  const combo=$("comboRow");
  if(player.char==="vyron"){
    combo.style.display="flex";
    $("comboLbl").textContent="Pasif";
    const n=TUNE.vyron.strongEvery-(vy.shots%TUNE.vyron.strongEvery);
    $("comboVal").textContent=n===1?"SIRADAKİ!":n+" atak";
  }else if(player.char==="meda"){
    combo.style.display="flex";
    $("comboLbl").textContent="Pasif";
    const n=TUNE.meda.knockEvery-(me.shots%TUNE.meda.knockEvery);
    $("comboVal").textContent=n===1?"SIRADAKİ!":n+" atak";
  }else if(player.char==="xort"){
    combo.style.display="flex";
    $("comboLbl").textContent="Pasif";
    const n=TUNE.xort.splashEvery-(xo.shots%TUNE.xort.splashEvery);
    $("comboVal").textContent=n===1?"SIRADAKİ!":n+" atak";
  }else if(player.char==="arhas"){
    combo.style.display="flex";
    $("comboLbl").textContent="Pasif";
    $("comboVal").textContent=ah.calm>=TUNE.arhas.calmT?"YENİLENİYOR":Math.ceil(TUNE.arhas.calmT-ah.calm)+" sn";
  }else if(player.char==="truesun"){
    combo.style.display="flex";$("comboLbl").textContent="Gök Yükü";$("comboVal").textContent=tr.stacks.toLocaleString("tr-TR");
  }else if(player.char==="eron"){
    combo.style.display="flex";
    $("comboLbl").textContent="Pasif";
    const n=TUNE.eron.healEvery-((player.shots||0)%TUNE.eron.healEvery);
    $("comboVal").textContent=n===1?"SIRADAKİ!":n+" atak";
  }else combo.style.display="none";

  updateStatPanel(now);
  updateBossBar();
  $("upgRow").textContent=player.upg.map(u=>u.ico).join("");
  $("pauseBtn").style.display=(playing&&!paused&&!gameOver)?"block":"none";
}

function loop(ts,id){
  if(id!==runId)return;            // eski bir oyunun döngüsüyse dur
  let dt=Math.min(.035,Math.max(0,(ts-lastTime)/1000));
  lastTime=ts;
  if(!paused){clock+=dt*1000;update(dt,clock)}
  draw();updateUI(clock);
  if(!gameOver)requestAnimationFrame(t=>loop(t,id));
}

