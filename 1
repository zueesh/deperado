function updateVenom(dt){
  const A=ARACH;
  // yumurtalar: 4 sn içinde kırılmazsa patlar ve örümcekler çıkar
  for(const e of [...enemies]){
    if(e.type==="egg"){e.hatchT-=dt;if(e.hatchT<=0)hatchEgg(e)}
  }
  // tükürülen zehir uçar, düştüğü yerde birikinti bırakır
  for(const g of [...bossState.globs]){
    g.t-=dt;
    if(g.t<=0){
      bossState.globs.splice(bossState.globs.indexOf(g),1);
      bossState.venom.push({x:g.tx,y:g.ty,r:A.puddleR,life:A.puddleLife});
      burst(g.tx,g.ty,"#84cc16",14);
    }
  }
  // zehir birikintisi: üstünde 0.3 sn'de bir 5 hasar ve zehir etkisi
  let inside=false;
  for(const v of [...bossState.venom]){
    v.life-=dt;
    if(v.life<=0){bossState.venom.splice(bossState.venom.indexOf(v),1);continue}
    if(Math.hypot(player.x-v.x,player.y-v.y)<v.r+player.r*.5)inside=true;
  }
  if(inside){
    bossState.venomT=(bossState.venomT===undefined?A.puddleTick:bossState.venomT)-dt;
    if(bossState.venomT<=0){bossState.venomT=A.puddleTick;playerHit(A.puddleDmg)}
    applyPoison();
  }else bossState.venomT=A.puddleTick;
  // zehir etkisi: 3 sn boyunca 1 sn arayla 10 hasar (toplam 3 kez)
  if(player.poison){
    const p=player.poison;
    p.left-=dt;p.tick-=dt;
    if(p.tick<=0&&p.ticks<Math.round(A.poisonDur/A.poisonTick)){p.tick+=A.poisonTick;p.ticks++;playerHit(A.poisonDmg)}
    if(p.left<=0)player.poison=null;
  }
  // atlayışın fırlatması, sonra ağa yapışma
  if(player.kb){
    const k=player.kb;
    const sdt=Math.min(dt,k.t);                            // son karede fazladan gitmesin: toplam tam fırlatma mesafesi kadar
    player.x=Math.max(player.r,Math.min(W-player.r,player.x+k.vx*sdt));
    player.y=Math.max(player.r,Math.min(H-player.r,player.y+k.vy*sdt));
    goal.x=player.x;goal.y=player.y;
    k.t-=dt;
    if(k.t<=0){player.kb=null;if(k.root!==false)player.rooted=A.pounceRoot}
  }
  if(player.rooted>0)player.rooted=Math.max(0,player.rooted-dt);
}

function updateArachmor(b,dt){
  const A=ARACH,scale=bossScale();
  b.age+=dt;
  if(b.st==="intro"){                                   // yukarıdan iner, dokunulmaz
    b.hp=b.maxHp;
    b.stT-=dt;
    b.y=-b.r+(150+b.r)*(1-Math.max(0,b.stT)/A.intro);
    if(b.stT<=0)b.st="walk";
    return;
  }
  if(!b.phase2&&b.hp/b.maxHp<A.rageAt){                 // pasif: can %50 altı
    b.phase2=true;
    showBanner("ARACHMOR ÇILDIRDI! 2 YUMURTA, 3 ÖRÜMCEK","#e9d5ff");
  }
  const dx=player.x-b.x,dy=player.y-b.y,d=Math.hypot(dx,dy)||1;
  b.biteCd-=dt;
  if(b.st==="walk"){
    b.facing=Math.atan2(dy,dx);
    if(b.age>=b.pounceNext){b.st="pwind";b.stT=A.pounceWind;b.pounceNext=b.age+A.pounceCd}
    else if(b.age>=b.spitNext){b.st="spit";b.stT=A.spitWind;b.spitNext=b.age+A.spitCd}
    else if(b.age>=b.eggNext){b.st="lay";b.stT=A.eggCast;b.eggNext=b.age+A.eggCd}
    else{
      const reach=b.r+player.r+A.biteReach;
      if(d>reach*.9){b.x+=dx/d*A.speed*dt;b.y+=dy/d*A.speed*dt;clampBoss(b)}
      if(d<=reach&&b.biteCd<=0){b.st="bite";b.stT=A.biteWind}
    }
  }else if(b.st==="bite"){                              // ısırık
    b.facing=Math.atan2(dy,dx);
    b.stT-=dt;
    if(b.stT<=0){
      if(d<=b.r+player.r+A.biteReach+12)playerHit(b.damage);
      b.biteCd=A.biteCd;b.st="walk";
    }
  }else if(b.st==="lay"){                               // yumurta bırakır
    b.stT-=dt;
    if(b.stT<=0){layEggs(b);b.st="walk"}
  }else if(b.st==="spit"){                              // sana doğru zehir tükürür
    b.facing=Math.atan2(dy,dx);
    b.stT-=dt;
    if(b.stT<=0){
      bossState.globs.push({x:b.x,y:b.y,tx:player.x,ty:player.y,t:A.spitTravel,max:A.spitTravel});
      b.st="walk";
    }
  }else if(b.st==="pwind"){                             // 1.5 sn sabit kalır, sonra ağlarıyla tavana çıkar
    b.facing=Math.atan2(dy,dx);
    b.stT-=dt;
    if(b.stT<=0){
      b.st="up";b.hpLock=b.hp;
      if(target===b){target=null;goal.x=player.x;goal.y=player.y}
    }
  }else if(b.st==="up"){
    b.hp=b.hpLock;
    b.y-=1100*dt;
    if(b.y<-b.r*2.2){b.st="off";b.stT=rand(A.pounceOff[0],A.pounceOff[1]);b.shadowed=false}
  }else if(b.st==="off"){                               // ekran dışında; inmeden 0.8 sn önce gölgesi çıkar
    b.hp=b.hpLock;
    b.stT-=dt;
    if(!b.shadowed&&b.stT<=A.pounceShadow-.18){      // gölge, inişten tam 0.8 sn önce çıkar (0.18 sn düşme süresi dahil)
      b.shadowed=true;
      b.landX=Math.max(b.r,Math.min(W-b.r,player.x));b.landY=Math.max(b.r,Math.min(H-b.r,player.y));
      bossState.shadows.push({x:b.landX,y:b.landY,t:Math.max(.05,b.stT+.18),max:A.pounceShadow});
    }
    if(b.stT<=0){b.st="land";b.stT=.18;b.x=b.landX;b.y=-b.r*2.2}
  }else if(b.st==="land"){                              // gölgenin üstüne düşer
    b.hp=b.hpLock;
    b.stT-=dt;
    b.y=-b.r*2.2+(b.landY+b.r*2.2)*(1-Math.max(0,b.stT)/.18);
    if(b.stT<=0){
      b.x=b.landX;b.y=b.landY;
      bossState.shadows.length=0;
      rings.push({x:b.x,y:b.y,r:A.pounceR+30,life:.4,color:"#e9d5ff"});
      burst(b.x,b.y,"#c4b5fd",30);
      if(Math.hypot(player.x-b.landX,player.y-b.landY)<A.pounceR+player.r*.5){
        playerHit(A.pounceDmg*scale);
        let kx=player.x-b.landX,ky=player.y-b.landY;
        if(Math.hypot(kx,ky)<1){kx=player.x-W/2;ky=player.y-H/2}      // tam üstüne indiyse harita merkezinden dışarı doğru fırlat
        let kd=Math.hypot(kx,ky);
        if(kd<1){kx=1;ky=0;kd=1}
        kx/=kd;ky/=kd;
        player.kb={vx:kx*A.pounceKnock/A.pounceKnockT,vy:ky*A.pounceKnock/A.pounceKnockT,t:A.pounceKnockT};   // uzağa fırlatır
        target=null;
      }
      b.st="recover";b.stT=A.pounceRecover;
    }
  }else if(b.st==="recover"){
    b.stT-=dt;
    if(b.stT<=0)b.st="walk";
  }
}

function pointSegmentDistance(px,py,x1,y1,x2,y2){
  const dx=x2-x1,dy=y2-y1,l2=dx*dx+dy*dy||1;
  const t=Math.max(0,Math.min(1,((px-x1)*dx+(py-y1)*dy)/l2));
  return Math.hypot(px-(x1+t*dx),py-(y1+t*dy));
}
function seerHit(b,dmg){
  playerHit(dmg*bossScale());
  if(b.hp/b.maxHp<=SEER.burnAt){
    player.seerBurn={left:SEER.burnLife,tick:SEER.burnTick};
  }
}
function updateSeer(b,dt){
  const S=SEER; b.age+=dt; b.anim=Math.max(0,b.anim-dt);
  if(b.st==="intro"){
    b.hp=b.maxHp;b.stT-=dt;
    b.y=-b.r+(150+b.r)*(1-Math.max(0,b.stT)/S.intro);
    if(b.stT<=0)b.st="idle";
    return;
  }
  const dx=player.x-b.x,dy=player.y-b.y,d=Math.hypot(dx,dy)||1;
  const targetFacing=Math.atan2(dy,dx),faceDiff=Math.atan2(Math.sin(targetFacing-(b.facing||0)),Math.cos(targetFacing-(b.facing||0)));
  b.facing=(b.facing||0)+Math.sign(faceDiff)*Math.min(Math.abs(faceDiff),S.faceTurn*dt);
  b.tentacleNext-=dt;b.riftNext-=dt;b.laserNext-=dt;b.closeCd-=dt;
  // SEER oyuncuyu ağır ama kararlı biçimde kovalar. Lazer sırasında sabit kalıp yalnızca başını döndürür.
  if(!b.laser&&b.st!=="close"&&d>b.r+player.r+20){b.x+=dx/d*S.chaseSpeed*dt;b.y+=dy/d*S.chaseSpeed*dt;clampBoss(b)}
  if(b.tentacleImpact){b.tentacleImpact.t-=dt;if(b.tentacleImpact.t<=0)b.tentacleImpact=null;}
  // Dokunaç: oyuncunun o anki konumuna kilitlenir, bir saniye önceden işaretlenir.
  if(!b.tentacle&&b.tentacleNext<=0&&!b.laser){
    b.tentacle={x:player.x,y:player.y,w:S.tentacleW,h:S.tentacleH,t:S.tentacleWarn,max:S.tentacleWarn,hit:false};
    b.tentacleNext=S.tentacleCd;
  }
  if(b.tentacle){
    b.tentacle.t-=dt;
    if(b.tentacle.t<=0){
      const q=b.tentacle;
      b.tentacleImpact={x:q.x,y:q.y,t:.42};
      rings.push({x:q.x,y:q.y,r:Math.max(q.w,q.h)*.55,life:.45,color:"#fb7185"});
      burst(q.x,q.y,"#fb7185",30);
      if(Math.abs(player.x-q.x)<=q.w/2+player.r&&Math.abs(player.y-q.y)<=q.h/2+player.r)seerHit(b,S.tentacleDmg);
      b.tentacle=null;
    }
  }
  // Yarık, bossun merkezinden oyuncunun bulunduğu yöne doğru uzanan kalıcı bir dikdörtgen.
  if(!b.rift&&b.riftNext<=0&&!b.laser){
    const ang=Math.atan2(dy,dx),sx=b.x+Math.cos(ang)*(b.r*.65),sy=b.y+Math.sin(ang)*(b.r*.65);
    b.rift={x1:sx,y1:sy,x2:sx+Math.cos(ang)*S.riftLength,y2:sy+Math.sin(ang)*S.riftLength,ang,left:S.riftLife,tick:S.riftTickCd,hitOnce:false};
    b.riftNext=S.riftCd;
    if(pointSegmentDistance(player.x,player.y,sx,sy,b.rift.x2,b.rift.y2)<=S.riftWidth/2+player.r){seerHit(b,S.riftHit);b.rift.hitOnce=true}
  }
  if(b.rift){
    const r=b.rift;r.left-=dt;r.tick-=dt;
    if(r.left>0&&pointSegmentDistance(player.x,player.y,r.x1,r.y1,r.x2,r.y2)<=S.riftWidth/2+player.r){
      if(r.tick<=0){r.tick=S.riftTickCd;seerHit(b,S.riftTick)}
    }
    if(r.left<=0)b.rift=null;
  }
  // Lazer beş saniye boyunca oyuncunun anlık konumuna yumuşakça döner.
  if(!b.laser&&b.laserNext<=0&&!b.tentacle&&!b.rift){b.laser={ang:b.facing,left:S.laserLife,tick:0};b.laserNext=S.laserCd}
  if(b.laser){
    const l=b.laser;
    // Işın ayrı bir hedef açısı kullanmaz: doğrudan göz bebeğinin baktığı yönü izler.
    // Böylece lazer, gözün içinden çıkar ve kafa dönüşüyle aynı yavaşlıkta oyuncuya yönelir.
    l.ang=b.facing||0;
    l.left-=dt;l.tick-=dt;
    const sx=b.x+Math.cos(l.ang)*23,sy=b.y+Math.sin(l.ang)*23;
    const ex=sx+Math.cos(l.ang)*1500,ey=sy+Math.sin(l.ang)*1500;
    if(pointSegmentDistance(player.x,player.y,sx,sy,ex,ey)<=13+player.r){if(l.tick<=0){l.tick=S.laserTick;seerHit(b,S.laserDmg)}}
    if(l.left<=0)b.laser=null;
  }
  // Yakın mesafe dokunaç darbesi; aralıklı ve önceden hazırlanarak gelir.
  if(d<=b.r+player.r+S.closeReach&&b.closeCd<=0&&b.st!=="close") {b.st="close";b.stT=S.closeWind}
  if(b.st==="close"){
    b.stT-=dt;
    if(b.stT<=0){
      if(Math.hypot(player.x-b.x,player.y-b.y)<=b.r+player.r+S.closeReach+8)seerHit(b,S.closeDmg);
      b.closeCd=S.closeCd;b.st="idle";b.anim=.3;
    }
  }
  // Yaşarmış göz: bossun tüm saldırıları yanma uygular; lazer/yarık tikleri de buna dahildir.
  if(player.seerBurn){
    const f=player.seerBurn;f.left-=dt;f.tick-=dt;
    if(f.tick<=0&&f.left>0){f.tick+=S.burnTick;playerHit(S.burnDmg)}
    if(f.left<=0)player.seerBurn=null;
  }
}

function updateBoss(dt){
  const B=BOSS;
  if(bossState.rewardIn>0){
    bossState.rewardIn-=dt;
    if(bossState.rewardIn<=0){bossState.rewardIn=0;openRewards()}
  }
  // yer çemberleri (boss ölse de bir sonraki bossa kadar temizlenir)
  updateVenom(dt);
  const b=bossState.boss;
  for(const c of [...bossState.circles]){
    c.t-=dt;
    if(c.t<=0){
      bossState.circles.splice(bossState.circles.indexOf(c),1);
      rings.push({x:c.x,y:c.y,r:c.r,life:.35,color:"#f87171"});
      burst(c.x,c.y,"#f87171",14);
      if(Math.hypot(player.x-c.x,player.y-c.y)<c.r+player.r*.6)playerHit(c.dmg);
    }
  }
  if(!b)return;
  if(b.kind==="arachmor"){updateArachmor(b,dt);return}
  if(b.kind==="seer"){updateSeer(b,dt);return}
  if(b.kind==="malgrav"){updateMalgrav(b,dt);return}
  b.age+=dt;
  b.anim=Math.max(0,b.anim-dt);
  const rageNow=b.hp/b.maxHp<B.rageAt;
  if(rageNow&&!b.rage){b.rage=true;showBanner("ÖFKE! İki kat hızlı ve sert","#f87171")}
  const mul=b.rage?B.rageMul:1,scale=bossScale();
  const px=player.x,py=player.y;

  if(b.st==="intro"){                                   // yukarıdan iner, dokunulmaz
    b.hp=b.maxHp;
    b.stT-=dt;
    b.y=-b.r+(150+b.r)*(1-Math.max(0,b.stT)/B.intro);
    if(b.stT<=0)b.st="walk";
    return;
  }

  // yer çemberleri: arka planda çalışır, boss yürümeye devam eder
  if(b.ringLeft===0&&b.age>=b.ringNext){b.ringLeft=B.ringCount;b.ringTick=0;b.ringNext=b.age+B.ringCd}
  if(b.ringLeft>0){
    b.ringTick-=dt;
    if(b.ringTick<=0){
      b.ringTick=B.ringGap;b.ringLeft--;
      bossState.circles.push({x:px,y:py,t:B.ringWarn,max:B.ringWarn,r:B.ringR,dmg:B.ringDmg*scale*mul});
    }
  }

  const dx=px-b.x,dy=py-b.y,d=Math.hypot(dx,dy)||1;
  b.swingCd-=dt;

  if(b.st==="walk"){
    b.facing=Math.atan2(dy,dx);
    if(b.age>=b.chargeNext){b.st="cwind";b.stT=B.chargeWind;b.chargeNext=b.age+B.chargeCd}
    else if(b.age>=b.summonNext){b.st="cast";b.stT=B.summonCast;b.summonNext=b.age+B.summonCd}
    else{
      const reach=b.r+player.r+B.clubReach;
      if(d>reach*.85){b.x+=dx/d*B.speed*mul*dt;b.y+=dy/d*B.speed*mul*dt;clampBoss(b)}
      if(d<=reach&&b.swingCd<=0){b.st="swing";b.stT=B.clubWind}
    }
  }else if(b.st==="swing"){                             // sopayı kaldırır, sonra vurur
    b.facing=Math.atan2(dy,dx);
    b.stT-=dt;
    if(b.stT<=0){
      const reach=b.r+player.r+B.clubReach;
      b.anim=.25;
      rings.push({x:b.x+Math.cos(b.facing)*b.r,y:b.y+Math.sin(b.facing)*b.r,r:B.clubReach+20,life:.25,color:"#fecaca"});
      if(Math.hypot(player.x-b.x,player.y-b.y)<=reach)playerHit(b.damage*mul);
      b.swingCd=B.clubCd;b.st="walk";
    }
  }else if(b.st==="cwind"){                             // 1 sn durur ve sana kilitlenir
    b.facing=Math.atan2(dy,dx);
    b.stT-=dt;
    if(b.stT<=0){b.dir={x:dx/d,y:dy/d};b.facing=Math.atan2(b.dir.y,b.dir.x);b.st="crun";b.hit=false}
  }else if(b.st==="crun"){                              // kilitlendiği yöne düz koşar
    b.x+=b.dir.x*B.chargeSpeed*dt;b.y+=b.dir.y*B.chargeSpeed*dt;
    if(!b.hit&&Math.hypot(player.x-b.x,player.y-b.y)<b.r+player.r){b.hit=true;playerHit(B.chargeDmg*scale*mul)}
    for(const e of [...enemies]){
      if(e!==b&&Math.hypot(e.x-b.x,e.y-b.y)<b.r+e.r){burst(e.x,e.y,e.color,6);silentRemove(e)}   // yoluna çıkan her şey ezilir
    }
    if(b.x-b.r<=0||b.x+b.r>=W||b.y-b.r<=0||b.y+b.r>=H){
      clampBoss(b);
      b.st="cstun";b.stT=B.chargeStun;
      rings.push({x:b.x,y:b.y,r:b.r+50,life:.4,color:"#fca5a5"});
      burst(b.x,b.y,"#fca5a5",30);
    }
  }else if(b.st==="cstun"){                             // duvara çarpınca kısa süre sersemler
    b.stT-=dt;
    if(b.stT<=0)b.st="walk";
  }else if(b.st==="cast"){                              // yaratık çağırır
    b.facing=Math.atan2(dy,dx);
    b.stT-=dt;
    if(b.stT<=0){summonMinions(b);b.st="walk"}
  }
}

function updateBossBar(){
  const b=bossState.boss,bar=$("bossBar");
  if(!b){bar.style.display="none";return}
  bar.style.display="block";
  const pct=Math.max(0,100*b.hp/b.maxHp)+"%";
  $("bossHpFill").style.width=pct;
  $("bossHpTrail").style.width=pct;
  $("bossHpTxt").textContent=Math.ceil(Math.max(0,b.hp))+" / "+Math.ceil(b.maxHp);
  $("bossName").textContent=BOSSES[b.kind].name;
  bar.classList.toggle("rage",!!b.rage);
}

function spiderLegs(x,y,facing,size,moving,color,joint){
  // yukarıdan görünüş: gövde ekseni +x (ileri). 4 çift bacak, her biri iki parçalı
  ctx.save();ctx.translate(x,y);ctx.rotate(facing);
  ctx.lineCap="round";ctx.lineJoin="round";
  for(let side=-1;side<=1;side+=2){
    for(let i=0;i<4;i++){
      const base=(Math.PI/2+(i-1.5)*.5)*side;
      const sw=moving?Math.sin(clock/150+i*1.7+(side>0?0:Math.PI))*.2:0;
      const a1=base+sw*side,a2=base+(side>0?.5:-.5)*(0.9+i*.12)+sw*side;
      const ax=(20-i*14)*size,ay=side*10*size;
      const mx=ax+Math.cos(a1)*50*size,my=ay+Math.sin(a1)*50*size;
      const fx=mx+Math.cos(a2)*(48+i*4)*size,fy=my+Math.sin(a2)*(48+i*4)*size;
      ctx.strokeStyle=color;ctx.lineWidth=9*size;
      ctx.beginPath();ctx.moveTo(ax,ay);ctx.lineTo(mx,my);ctx.stroke();
      ctx.lineWidth=5*size;ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(fx,fy);ctx.stroke();
      ctx.fillStyle=joint;ctx.beginPath();ctx.arc(mx,my,5*size,0,Math.PI*2);ctx.fill();
    }
  }
  ctx.lineCap="butt";
  ctx.restore();
}

// Tehlikeler: tükürülen zehir, zehir birikintileri, atlayışın gölgesi
function drawArachHazards(){
  const A=ARACH;
  for(const v of bossState.venom){
    ctx.globalAlpha=Math.min(1,v.life)*.85;
    ctx.fillStyle="#3f6212";ctx.beginPath();ctx.arc(v.x,v.y,v.r,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#a3e635";ctx.lineWidth=3;ctx.stroke();
    ctx.fillStyle="rgba(190,242,100,.45)";
    for(let i=0;i<4;i++){const a=clock/500+i*1.6+v.x,rr=v.r*.45;ctx.beginPath();ctx.arc(v.x+Math.cos(a)*rr,v.y+Math.sin(a*1.2)*rr,4+i,0,Math.PI*2);ctx.fill()}
    ctx.globalAlpha=1;
  }
  for(const g of bossState.globs){
    const p=1-g.t/g.max;
    const x=g.x+(g.tx-g.x)*p,y=g.y+(g.ty-g.y)*p-Math.sin(p*Math.PI)*60;
    ctx.fillStyle="rgba(163,230,53,.25)";ctx.beginPath();ctx.arc(g.tx,g.ty,A.puddleR*p,0,Math.PI*2);ctx.fill();   // düşeceği yer
    ctx.fillStyle="#84cc16";ctx.strokeStyle="#365314";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(x,y,13,0,Math.PI*2);ctx.fill();ctx.stroke();
  }
  for(const sh of bossState.shadows){                   // atlayış gölgesi: büyür, kırmızıya döner
    const p=1-sh.t/sh.max;
    ctx.fillStyle="rgba(0,0,0,"+(.25+p*.3)+")";
    ctx.beginPath();ctx.arc(sh.x,sh.y,A.pounceR*(.55+.45*p),0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="rgba(239,68,68,"+(.5+Math.sin(clock/50)*.3)+")";ctx.lineWidth=4;
    ctx.beginPath();ctx.arc(sh.x,sh.y,A.pounceR,0,Math.PI*2);ctx.stroke();
  }
}

function drawEggBody(e){
  const p=e.hatchT/e.hatchMax;
  ctx.fillStyle="#ede9fe";ctx.strokeStyle="#7c3aed";ctx.lineWidth=3;
  ctx.beginPath();ctx.ellipse(e.x,e.y,e.r*.82,e.r*1.05,0,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle="rgba(124,58,237,.35)";
  ctx.beginPath();ctx.arc(e.x-4,e.y-3,3,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(e.x+5,e.y+4,2.5,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle="rgba(239,68,68,.9)";ctx.lineWidth=3;                          // patlamaya kalan süre
  ctx.beginPath();ctx.arc(e.x,e.y,e.r+7,-Math.PI/2,-Math.PI/2+Math.PI*2*Math.max(0,p));ctx.stroke();
  if(p<.35){                                                                       // çatlamaya başladı
    ctx.strokeStyle="#4c1d95";ctx.lineWidth=1.5;
    ctx.beginPath();ctx.moveTo(e.x-5,e.y-10);ctx.lineTo(e.x,e.y-2);ctx.lineTo(e.x-3,e.y+4);ctx.lineTo(e.x+4,e.y+10);ctx.stroke();
  }
}

function drawSpiderBody(e){
  spiderLegs(e.x,e.y,Math.atan2(player.y-e.y,player.x-e.x),.2,true,"#2e1065","#7c3aed");
  ctx.fillStyle=e.color;ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle="#0f0a1e";ctx.lineWidth=2;ctx.stroke();
  ctx.fillStyle="#f87171";ctx.beginPath();ctx.arc(e.x+3,e.y-2,1.8,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(e.x+3,e.y+2,1.8,0,Math.PI*2);ctx.fill();
}

function updateMalgrav(b,dt){
  const M=MALGRAV; b.age+=dt; b.anim=Math.max(0,b.anim-dt); b.attackAnim=Math.max(0,(b.attackAnim||0)-dt);
  const rage=b.hp/b.maxHp<=M.rageAt; if(rage&&!b.rage){b.rage=true;showBanner("MALGRAV ÖFKEYE KAPILDI!","#c084fc");burst(b.x,b.y,"#a855f7",36)}
  const speed=M.speed*(b.rage?M.rageSpeed:1),dmgMul=b.rage?M.rageDamage:1,cdr=b.rage?M.rageCdr:1;
  const dx=player.x-b.x,dy=player.y-b.y,d=Math.hypot(dx,dy)||1; b.facing=Math.atan2(dy,dx);
