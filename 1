/* ---------- VYRON ---------- */
const ORB_DIST=58,ORB_R=9,ORB_SPEED=6.5;   // Q topları: dönüş mesafesi, boyut, dönüş hızı (rad/sn)
const AURA_R=115;                          // W aurası ve E patlamasının yarıçapı
const ULT_CORE=26,ULT_AURA=62,ULT_SPEED=100,ULT_RANGE=260;  // R topu: çekirdek, aura, hız, bırakma menzili

function canvasPos(e){
  const rect=canvas.getBoundingClientRect();
  return{x:(e.clientX-rect.left)*W/rect.width,y:(e.clientY-rect.top)*H/rect.height};
}

// Nişan noktasını menzile ve harita içine sınırlar
function clampUlt(x,y){
  let dx=x-player.x,dy=y-player.y;
  const d=Math.hypot(dx,dy);
  if(d>ULT_RANGE){dx=dx/d*ULT_RANGE;dy=dy/d*ULT_RANGE}
  return{x:Math.max(ULT_CORE,Math.min(W-ULT_CORE,player.x+dx)),
         y:Math.max(ULT_CORE,Math.min(H-ULT_CORE,player.y+dy))};
}

// Bulunduğu noktaya en uzak duvara doğru yön
function ultDir(x,y){
  const opts=[{d:x,x:-1,y:0},{d:W-x,x:1,y:0},{d:y,x:0,y:-1},{d:H-y,x:0,y:1}];
  return opts.reduce((a,b)=>b.d>a.d?b:a);
}

function cancelAim(){
  if(vy)vy.aiming=false;
  canvas.classList.remove("aiming");
}

function placeUlt(pos){
  const p=clampUlt(pos.x,pos.y);
  const dir=ultDir(p.x,p.y);
  vy.ball={x:p.x,y:p.y,dx:dir.x*ULT_SPEED,dy:dir.y*ULT_SPEED,tick:0};
  cooldowns.r=clock/1000+TUNE.vyron.rCd;
  cancelAim();
  burst(p.x,p.y,"#67e8f9",20);
  say("ENERJİ TOPU bırakıldı! Çekirdeğe değen düşman infaz edilir.");
}

// Lazer: anında vurur. Her 4. atak daha güçlüdür.
function fireLaser(e){
  if(!enemies.includes(e))return;
  vy.shots++;
  const strong=vy.shots%TUNE.vyron.strongEvery===0;
  const sx=player.x+Math.cos(player.facing)*20,sy=player.y+Math.sin(player.facing)*20;
  const life=strong?.14:.09;
  beams.push({x1:sx,y1:sy,x2:e.x,y2:e.y,life,max:life,color:strong?"#f0abfc":"#67e8f9",w:strong?6:2.5});
  e.hp-=player.damage*(strong?TUNE.vyron.strongMul:1);
  burst(e.x,e.y,strong?"#f0abfc":"#67e8f9",strong?8:3);
  if(e.hp<=0)killEnemy(e);
}

// Süreli yeteneklerde bekleme süresi, yetenek bitince başlar
function endVyronW(){
  if(!vy.w)return;
  vy.w=false;
  cooldowns.w=clock/1000+TUNE.vyron.wCd;
}
function endVyronQ(){
  if(!vy.q)return;
  vy.q=false;vy.qLeft=0;
  endVyronW();
  cooldowns.q=clock/1000+TUNE.vyron.qCd;
}

function useVyronSkill(key,now){
  const ready=(cooldowns[key]||0)<=now;
  if(key!=="r")cancelAim();   // başka yeteneğe basınca nişan iptal olur

  if(key==="q"){
    if(vy.q||!ready)return;
    vy.q=true;vy.qLeft=TUNE.vyron.qDur;vy.angle=0;
    cooldowns.q=1e9;                              // bekleme Q bitince başlar
    rings.push({x:player.x,y:player.y,r:ORB_DIST+12,life:.3,color:"#67e8f9"});
    say("Lazer topları aktif! Topların öldürdüğü her düşman süreyi uzatır.");
  }
  if(key==="w"){
    if(vy.w){endVyronW();say("Şok aurası kapatıldı.");return}   // tekrar basınca erken kapanır
    if(!vy.q){say("W için önce Q aktif olmalı.");return}
    if(!ready)return;
    vy.w=true;vy.wTick=0;
    cooldowns.w=1e9;                              // bekleme W bitince başlar
    rings.push({x:player.x,y:player.y,r:AURA_R,life:.3,color:"#67e8f9"});
    say("Şok aurası aktif! Hareket hızın %"+nr(TUNE.vyron.wSelfSlow*100)+" azaldı.");
  }
  if(key==="e"){
    if(!vy.q){say("E için önce Q aktif olmalı.");return}
    if(vy.w){say("W açıkken E kullanılamaz.");return}
    if(!ready)return;
    for(const e of [...enemies]){
      if(Math.hypot(e.x-player.x,e.y-player.y)<AURA_R+e.r){
        e.hp-=player.damage*TUNE.vyron.eMul;
        burst(e.x,e.y,"#a5f3fc",6);
        if(e.hp<=0)killEnemy(e);
      }
    }
    player.hp=Math.min(player.maxHp,player.hp+player.maxHp*TUNE.vyron.eHeal);
    endVyronQ();
    cooldowns.e=now+TUNE.vyron.eCd;
    rings.push({x:player.x,y:player.y,r:AURA_R,life:.3,color:"#a5f3fc"});
    burst(player.x,player.y,"#67e8f9",24);
    say("Toplar patladı! Canın %"+nr(TUNE.vyron.eHeal*100)+" yenilendi.");
  }
  if(key==="r"){
    if(vy.aiming){cancelAim();say("Nişan iptal edildi.");return}
    if(!ready)return;
    vy.aiming=true;
    canvas.classList.add("aiming");
    say("Topu bırakacağın noktaya tıkla (iptal: R / Esc / sağ tık)");
  }
}

function updateVyron(dt,now){
  for(const b of [...beams]){b.life-=dt;if(b.life<=0)beams.splice(beams.indexOf(b),1)}

  // Q: dönen lazer topları
  if(vy.q){
    vy.qLeft-=dt;
    vy.angle+=TUNE.vyron.orbSpeed*dt;
    const mul=1;
    for(const e of enemies){if(e.orbCd)for(let j=0;j<e.orbCd.length;j++)if(e.orbCd[j]>0)e.orbCd[j]-=dt}   // her topun her düşmana kendi bekleme süresi var
    for(let i=0;i<TUNE.vyron.orbs;i++){
      const a=vy.angle+i*Math.PI*2/TUNE.vyron.orbs;
      const ox=player.x+Math.cos(a)*ORB_DIST,oy=player.y+Math.sin(a)*ORB_DIST;
      for(const e of [...enemies]){
        if(e.orbCd&&e.orbCd[i]>0)continue;
        if(Math.hypot(e.x-ox,e.y-oy)<ORB_R+e.r){
          if(!e.orbCd)e.orbCd=[];
          e.orbCd[i]=.3;
          e.hp-=player.damage*TUNE.vyron.qMul*mul;
          burst(e.x,e.y,"#67e8f9",4);
          if(e.hp<=0){killEnemy(e);vy.qLeft+=TUNE.vyron.qExtend}   // sadece topların öldürmesi süreyi uzatır
        }
      }
    }
    if(vy.qLeft<=0)endVyronQ();                  // Q bitince W de biter, Q'nun beklemesi başlar
  }

  // W: şok aurası (yavaşlatır, 0.35 sn'de bir %2 can çalar)
  if(vy.w){
    vy.wTick-=dt;
    const tick=vy.wTick<=0;
    if(tick)vy.wTick=TUNE.vyron.wTick;
    for(const e of [...enemies]){
      if(Math.hypot(e.x-player.x,e.y-player.y)<AURA_R+e.r){
        e.slow=Math.max(e.slow,.25);
        if(tick){
          const amt=e.maxHp*TUNE.vyron.wSteal;
          e.hp-=amt;
          player.hp=Math.min(player.maxHp,player.hp+amt);
          if(e.hp<=0)killEnemy(e);
        }
      }
    }
  }

  // R: enerji topu
  if(vy.ball){
    const b=vy.ball;
    b.x+=b.dx*dt;b.y+=b.dy*dt;
    b.tick-=dt;
    const tick=b.tick<=0;
    if(tick)b.tick=TUNE.vyron.rAuraTick;
    for(const e of [...enemies]){
      const d=Math.hypot(e.x-b.x,e.y-b.y);
      if(d<ULT_CORE+e.r&&e.type!=="boss"){   // infaz boss'ta işlemez
        burst(e.x,e.y,"#e0f2fe",12);
        killEnemy(e);                                   // infaz
        cooldowns.q-=TUNE.vyron.rCdrQ;cooldowns.w-=TUNE.vyron.rCdrWE;cooldowns.e-=TUNE.vyron.rCdrWE; // R hariç bekleme süreleri azalır
      }else if(d<ULT_AURA+e.r){
        e.slow=Math.max(e.slow,.25);
        if(tick){
          e.hp-=player.damage*TUNE.vyron.rAuraMul;
          burst(e.x,e.y,"#67e8f9",3);
          if(e.hp<=0)killEnemy(e);
        }
      }
    }
    // gittiği yöndeki harita sınırına değince yok olur
    if((b.dx>0&&b.x+ULT_CORE>=W)||(b.dx<0&&b.x-ULT_CORE<=0)||(b.dy>0&&b.y+ULT_CORE>=H)||(b.dy<0&&b.y-ULT_CORE<=0)){
      vy.ball=null;
    }
  }
}

