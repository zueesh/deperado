function compactStatus(st,remain){
  const parts=st.text.split(" · ");
  if(remain>0&&!st.on)return remain.toFixed(1)+"s";            // bekleme süresi
  if(st.on){
    const t=parts[1]&&/ sn$/.test(parts[1])?" "+parts[1].replace(" sn","s"):"";
