    ctx.strokeStyle="#ef4444";ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle="rgba(239,68,68,.45)";
    ctx.beginPath();ctx.arc(b.x,b.y,T.rRadius*p,0,Math.PI*2);ctx.fill();
  }
