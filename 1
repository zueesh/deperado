function useSkill(key,fromKey){
  if(bossRushMode)bossRushSource="Yetenek "+String(key).toUpperCase();
  if(gameOver||!playing||paused||player.frozen>0)return;   // donmuşken yetenek ve tıklama çalışmaz
  let now=clock/1000;
  if(player.char==="vyron"){useVyronSkill(key,now);return}
  if(player.char==="xort"){useXortSkill(key,now);return}
  if(player.char==="ignar"){useIgnarSkill(key,now);return}
  if(player.char==="meda"){useMedaSkill(key,now);return}
  if(player.char==="azuron"){useAzuronSkill(key,now,fromKey);return}
  if(player.char==="arhas"){useArhasSkill(key,now);return}
  if(player.char==="truesun"){useTruesunSkill(key,now);return}
  if((cooldowns[key]||0)>now)return;

  if(key==="q"){
    if(player.rooted>0||player.kb)return;       // ağa yapışmışken dash atılamaz
    let dx=(target?target.x:goal.x)-player.x;
    let dy=(target?target.y:goal.y)-player.y;
    let len=Math.hypot(dx,dy);
    if(len<1){dx=Math.cos(player.facing);dy=Math.sin(player.facing);len=1}
    player.x+=dx/len*TUNE.eron.dashDist;
    player.y+=dy/len*TUNE.eron.dashDist;
    player.x=Math.max(player.r,Math.min(W-player.r,player.x));
    player.y=Math.max(player.r,Math.min(H-player.r,player.y));
    cooldowns.q=now+TUNE.eron.dashCd;
    burst(player.x,player.y,"#93c5fd",12);
  }
  if(key==="w"){
    mines.push({x:player.x,y:player.y,life:TUNE.eron.mineLife,r:15});
    cooldowns.w=now+TUNE.eron.mineCd;
    say("Mayın yerleştirildi!");
  }
  if(key==="e"){
    empowered=true;
    cooldowns.e=now+TUNE.eron.eCd;
    say("Sonraki okun alan hasarı verecek!");
  }
  if(key==="r"){
    ultEnd=now+TUNE.eron.rDur;
    cooldowns.r=1e9;                      // bekleme süresi ulti bitince başlar
    eronUltOn=true;
    say("ULTİ AKTİF! "+TUNE.eron.rDur+" saniye boyunca güçlendin.");
  }
}

