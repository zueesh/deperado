// Oyun sabit boyutta (W x H) çizilir; ekrana sığacak kadar büyütülür ya da küçültülür
function fitScreen(){
  if(typeof window==="undefined")return;
  const k=Math.min(window.innerWidth/W,window.innerHeight/H);
  $("frame").style.transform="translate(-50%,-50%) scale("+k+")";
}

function toggleFullscreen(){
  try{
    if(document.fullscreenElement){document.exitFullscreen();return}
    const r=document.documentElement.requestFullscreen?document.documentElement.requestFullscreen():null;
    Promise.resolve(r).then(()=>{
      try{window.screen.orientation.lock("landscape")}catch(_){}   // destekleyen telefonlarda yatay kilitle
    }).catch(()=>{});
  }catch(_){}
}

