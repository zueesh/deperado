    '<span class="val"><b id="sv-'+s.key+'"></b><i id="sg-'+s.key+'"></i></span></div>'
  ).join("");
}

function updateStatPanel(now){
  const u=(player.char==="eron"&&now/1000<ultEnd)||(player.char==="truesun"&&tr&&tr.empower>0);
  for(const s of STATS){
    const v=s.val(u);
    const row=$("row-"+s.key);
    const base=s.key==="level"?1:player.base[s.key];
    $("sv-"+s.key).textContent=s.fmt(v);
    const gain=v-base;
    $("sg-"+s.key).textContent=gain>0.001?"+"+(Math.round(gain*100)/100):"";
    row.classList.toggle("ult",!!(s.ult&&u));
    const prev=prevStats[s.key];
    if(prev!==undefined&&v>prev+0.0001&&!(s.ult&&u&&!prevStats.ult)){
      row.classList.remove("flash");void row.offsetWidth;row.classList.add("flash");
    }
    prevStats[s.key]=v;
  }
  prevStats.ult=u;
}

