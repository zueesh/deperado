function drawTruesunBody(){
  const a=player.facing;ctx.save();ctx.translate(player.x,player.y);ctx.rotate(a);
  // Ermişin altın omuzlukları ve açık renkli uzun cübbesi
  ctx.shadowBlur=12;ctx.shadowColor="#fbbf24";ctx.fillStyle="#b7791f";ctx.beginPath();ctx.ellipse(0,2,13,16,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle="#fff7d6";ctx.beginPath();ctx.moveTo(-10,-5);ctx.lineTo(0,-13);ctx.lineTo(10,-5);ctx.lineTo(8,13);ctx.lineTo(0,18);ctx.lineTo(-8,13);ctx.closePath();ctx.fill();
  ctx.strokeStyle="#d97706";ctx.lineWidth=2;ctx.stroke();
