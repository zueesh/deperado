function drawBoss(){
  if(!bossState)return;
  const B=BOSS;
  for(const c of bossState.circles){                    // yerde beliren tehlike çemberleri
    const p=1-c.t/c.max;
    ctx.fillStyle="rgba(239,68,68,"+(.1+p*.22)+")";
