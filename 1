// W bitince, W sırasında yenilen hasarın azaltılmamış hâli kadar can geri yüklenir
function endW(){
  cooldowns.w=clock/1000+TUNE.xort.wCd;                // bekleme W bitince başlar
  const gain=xo.wStored;
  xo.wStored=0;
  if(gain>0){
    player.hp=Math.min(player.maxHp,player.hp+gain);
    rings.push({x:player.x,y:player.y,r:player.r+34,life:.3,color:"#86efac"});
    burst(player.x,player.y,"#86efac",16);
    say("Savunma bitti! "+nr(gain)+" can geri yüklendi.");
  }else say("Savunma modu bitti.");
}

// Plazma topu: her 2. mermi alan hasarı verir. E basılıysa sonraki mermi seken saldırı olur.
function firePlasma(e){
  if(!enemies.includes(e))return;
  const T=TUNE.xort;
  const sx=player.x+Math.cos(player.facing)*18,sy=player.y+Math.sin(player.facing)*18;
  if(xo.eArmed){
    xo.eArmed=false;
    plasmas.push({x:sx,y:sy,target:e,tx:e.x,ty:e.y,speed:T.plasmaSpeed*1.4,kind:"bounce",damage:0,aoe:false});
    return;
  }
  xo.shots++;
  const aoe=xo.shots%T.splashEvery===0;
  plasmas.push({x:sx,y:sy,target:e,tx:e.x,ty:e.y,speed:T.plasmaSpeed,kind:"plasma",damage:player.damage,aoe});
}

// Seken saldırı: birbirine değen (ya da en çok bounceGap piksel boşluklu) düşmanlara, her birine bir kez
function bounceChain(first){
  const T=TUNE.xort;
  const order=[first],seen=new Set([first]);
  for(let i=0;i<order.length;i++){
    const a=order[i];
    for(const b of enemies){
      if(seen.has(b))continue;
      if(Math.hypot(a.x-b.x,a.y-b.y)-a.r-b.r<=T.bounceGap){
        seen.add(b);order.push(b);
        arcs.push({x1:a.x,y1:a.y,x2:b.x,y2:b.y,life:.35,max:.35});
      }
    }
  }
  const dmg=player.maxHp*T.eHpFrac;   // E hasarı azami canla büyür
  for(const e of order){
    e.hp-=dmg;
    e.stun=T.eStun;
    burst(e.x,e.y,"#93c5fd",6);
  }
  for(const e of order){if(e.hp<=0)killEnemy(e)}
}

function plasmaImpact(p){
  const T=TUNE.xort;
  const alive=p.target&&enemies.includes(p.target);
  if(p.kind==="bounce"){if(alive)bounceChain(p.target);return}
  if(p.aoe){
    rings.push({x:p.tx,y:p.ty,r:T.splashR,life:.3,color:"#fdba74"});
    burst(p.tx,p.ty,"#fcd34d",16);
    for(const e of [...enemies]){
      if(Math.hypot(e.x-p.tx,e.y-p.ty)<T.splashR+e.r){
        e.hp-=p.damage;
        if(e.hp<=0)killEnemy(e);
      }
    }
  }else if(alive){
    p.target.hp-=p.damage;
    burst(p.tx,p.ty,"#fb923c",5);
    if(p.target.hp<=0)killEnemy(p.target);
  }
}

function useXortSkill(key,now){
  const T=TUNE.xort;
  const ready=(cooldowns[key]||0)<=now;
  if(key==="r"){
    if(xo.ultOn){endUlt();say("Lazer formu kapandı.");return}
    if(!ready)return;
    xo.ultOn=true;xo.ultLeft=T.rDur;xo.holding=false;
    cooldowns.r=1e9;                                   // bekleme ulti bitince başlar
    target=null;goal.x=player.x;goal.y=player.y;
    rings.push({x:player.x,y:player.y,r:50,life:.3,color:"#fdba74"});
    say("LAZER FORMU! Işın için ekrana basılı tut ("+T.rDur+" sn). Yerinden kıpırdayamazsın.");
    return;
  }
  if(xo.ultOn){say("Ulti açıkken başka yetenek kullanılamaz.");return}
  if(key==="w"&&xo.wLeft>0){xo.wLeft=0;endW();return}   // W'ye tekrar basınca istediğin an kapanır ve biriken can anında gelir
  if(!ready)return;
  if(key==="q"){
    const hit=enemies.filter(e=>Math.hypot(e.x-player.x,e.y-player.y)<T.qRadius+e.r);
    const base=player.maxHp*T.qHpFrac;
    const dmg=base*(1+(hit.length-1)*T.qPerEnemy);
    cooldowns.q=now+T.qCd;
    rings.push({x:player.x,y:player.y,r:T.qRadius,life:.3,color:"#fdba74"});
    burst(player.x,player.y,"#fcd34d",20);
    for(const e of hit){
      e.hp-=dmg;
      burst(e.x,e.y,"#fcd34d",4);
    }
    for(const e of hit){if(e.hp<=0)killEnemy(e)}
    say(hit.length?"Şok dalgası! "+hit.length+" düşmana "+nr(dmg)+" hasar.":"Şok dalgası: menzilde düşman yoktu.");
  }
  if(key==="w"){
    xo.wLeft=T.wDur;xo.wStored=0;
    cooldowns.w=1e9;                                   // bekleme W bitince başlar
    rings.push({x:player.x,y:player.y,r:player.r+30,life:.3,color:"#93c5fd"});
    say("Savunma modu! "+T.wDur+" sn %"+nr(T.reduce*100)+" az hasar. Biriken can W bitince (ya da W'ye tekrar basınca) gelir.");
  }
  if(key==="e"){
    if(xo.eArmed)return;
    xo.eArmed=true;
    cooldowns.e=now+T.eCd;
    say("Sonraki atağın seken plazma olacak!");
  }
}

function updateXort(dt,now){
  const T=TUNE.xort;
  if(xo.wLeft>0){
    xo.wLeft=Math.max(0,xo.wLeft-dt);
    if(xo.wLeft===0)endW();
  }
  for(const a of [...arcs]){a.life-=dt;if(a.life<=0)arcs.splice(arcs.indexOf(a),1)}

  // plazma mermileri (hedefi takip eder)
  for(const p of [...plasmas]){
    if(p.target&&enemies.includes(p.target)){p.tx=p.target.x;p.ty=p.target.y}
    else if(p.kind==="bounce"){
      // hedef öldüyse en yakın düşmana geç
      let best=null,bd=1e9;
      for(const e of enemies){const dd=Math.hypot(e.x-p.x,e.y-p.y);if(dd<bd){bd=dd;best=e}}
      if(best){p.target=best;p.tx=best.x;p.ty=best.y}
      else{plasmas.splice(plasmas.indexOf(p),1);continue}
    }
    const dx=p.tx-p.x,dy=p.ty-p.y,d=Math.hypot(dx,dy),step=p.speed*dt;
    if(d<step+8){plasmaImpact(p);plasmas.splice(plasmas.indexOf(p),1)}
    else{p.x+=dx/d*step;p.y+=dy/d*step}
  }

  // R: lazer formu
  if(xo.ultOn){
    xo.ultLeft-=dt;
    player.facing=Math.atan2(mouse.y-player.y,mouse.x-player.x);
    for(const e of enemies){if(e.beamCd>0)e.beamCd-=dt}
    if(xo.holding){
      const ux=Math.cos(player.facing),uy=Math.sin(player.facing),hw=T.beamWidth/2;
      for(const e of [...enemies]){
        let t=(e.x-player.x)*ux+(e.y-player.y)*uy;
        t=Math.max(0,Math.min(T.beamLen,t));
        const px=player.x+ux*t,py=player.y+uy*t;
        if(Math.hypot(e.x-px,e.y-py)<hw+e.r&&!(e.beamCd>0)){
          e.beamCd=T.rTick;
          e.hp-=T.rDmg;
          burst(e.x,e.y,"#fde68a",3);
          if(e.hp<=0)killEnemy(e);
        }
      }
    }
    if(xo.ultLeft<=0){endUlt();say("Lazer formu bitti.")}
  }
}

