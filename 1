function fireTruesunAuto(e){
  if(!enemies.includes(e)||tr.transition>0||tr.ult&&tr.ult.phase==="flight")return;
  const T=TUNE.truesun;tr.stacks++;
  if(tr.mode==="spear"){
    const ang=Math.atan2(e.y-player.y,e.x-player.x);
    tr.autoSpear={x:player.x+Math.cos(ang)*22,y:player.y+Math.sin(ang)*22,dx:Math.cos(ang),dy:Math.sin(ang),target:e,left:Math.hypot(e.x-player.x,e.y-player.y),damage:player.damage};
  }else{
    const empowered=tr.empower>0,ang=player.facing;
    for(const v of [...enemies]){const dx=v.x-player.x,dy=v.y-player.y,d=Math.hypot(dx,dy),a=Math.atan2(dy,dx);let da=Math.atan2(Math.sin(a-ang),Math.cos(a-ang));if(d<125+v.r&&Math.abs(da)<.95){v.hp-=player.damage;burst(v.x,v.y,"#fbbf24",3);if(v.hp<=0)killEnemy(v)}}
    beams.push({x1:player.x-Math.cos(ang)*12,y1:player.y-Math.sin(ang)*12,x2:player.x+Math.cos(ang)*110,y2:player.y+Math.sin(ang)*110,life:.13,max:.13,color:"#fef08a",w:9});
  }
}
function useTruesunSkill(key,now){
  const T=TUNE.truesun;if(tr.transition>0||tr.ult&&tr.ult.phase==="flight")return;
  if(key==="q"){
    if(tr.mode==="spear"){if(tr.chargeActive)releaseTruesunQ();else beginTruesunQ();return}
    if(tr.swordQ||(cooldowns.q||0)>now)return;
    let ang=Math.atan2(mouse.y-player.y,mouse.x-player.x);if(target&&enemies.includes(target))ang=Math.atan2(target.y-player.y,target.x-player.x);player.facing=ang;
    tr.swordQ={ang,left:T.swordQDelay,stage:0,hits:tr.empower>0?3:1,mult:tr.empower>0?T.empowerDamage:1,hit:new Set()};cooldowns.q=now+T.swordQCd;say("İlahi Savuruş hazırlanıyor!");return;
  }
  if(key==="w"){truesunMode(tr.mode==="spear"?"sword":"spear");return}
  if(key==="e"){
    if(tr.mode==="spear"){
      if(tr.aim){tr.aim=null;return}if((cooldowns.e||0)>now)return;tr.aim="spearE";say("Işık Mabedi için bir nokta seç.");
    }else{
      if(tr.swordE||(cooldowns.e||0)>now)return;
      let ang=Math.atan2(mouse.y-player.y,mouse.x-player.x);if(target&&enemies.includes(target))ang=Math.atan2(target.y-player.y,target.x-player.x);player.facing=ang;
      tr.swordE={ang,left:.12,stage:0,hits:tr.empower>0?3:1,mult:tr.empower>0?T.empowerDamage:1,hit:new Set()};cooldowns.e=now+T.swordECd;say("Can Çalan Saplama!");
    }return;
  }
  if(key==="r"){
    if(tr.mode==="spear"){
      if(tr.rain||tr.stacks<=0)return;
      tr.rain={left:tr.stacks,tick:0,hitCount:new Map(),total:tr.stacks};tr.stacks=0;cooldowns.r=now+T.swordRCd;
      say("GÖKLERİN HÜKMÜ! "+tr.rain.left+" ışık mızrağı düşüyor.");
    }else{
      if(tr.ult||tr.arena||(cooldowns.r||0)>now)return;tr.aim="swordR";say("Kutsal İnfaz için haritada iniş noktası seç.");
    }
  }
}
function updateTruesun(dt,now){
  const T=TUNE.truesun;
  if(tr.transition>0)tr.transition=Math.max(0,tr.transition-dt);
  if(tr.chargeActive){player.facing=Math.atan2(mouse.y-player.y,mouse.x-player.x);if(tr.charge<T.qMax)tr.charge=Math.min(T.qMax,tr.charge+dt);else{tr.fullHold=(tr.fullHold||0)+dt;if(tr.fullHold>=4)releaseTruesunQ();}}
  if(tr.autoSpear){
    const a=tr.autoSpear,step=900*dt,dx=a.target.x-a.x,dy=a.target.y-a.y,d=Math.hypot(dx,dy);
    if(!enemies.includes(a.target)){tr.autoSpear=null;}
    else if(d<=step+a.target.r){a.target.hp-=a.damage;burst(a.target.x,a.target.y,"#fbbf24",5);if(a.target.hp<=0)killEnemy(a.target);tr.autoSpear=null;}
    else{a.x+=a.dx*step;a.y+=a.dy*step;}
  }
  if(tr.qShot){if(bossRushMode)bossRushSource="İlahi Mızrak";const q=tr.qShot,step=T.qSpeed*dt,move=Math.min(step,q.left);q.x+=q.dx*move;q.y+=q.dy*move;q.left-=move;
    for(const e of [...enemies])if(!q.hit.has(e)&&Math.hypot(e.x-q.x,e.y-q.y)<q.width/2+e.r){q.hit.add(e);e.hp-=q.damage;burst(e.x,e.y,"#fef08a",8);if(e.hp<=0)killEnemy(e)}
    if(q.left<=0||q.x<0||q.x>W||q.y<0||q.y>H)tr.qShot=null;
  }
  if(tr.field){if(bossRushMode)bossRushSource="Işık Mabedi";const f=tr.field;f.left-=dt;f.tick-=dt;if(f.tick<=0){f.tick=.5;player.hp=Math.min(player.maxHp,player.hp+T.eHeal*.5);for(const e of [...enemies])if(Math.hypot(e.x-f.x,e.y-f.y)<T.eRadius+e.r){e.hp-=T.eDmg*.5;if(e.hp<=0)killEnemy(e)}}if(f.left<=0)tr.field=null}
  if(tr.rain){const r=tr.rain;r.tick-=dt;if(r.tick<=0){r.tick=.12;let chosen=null;
      for(const e of enemies){const n=r.hitCount.get(e)||0;if(e.type==="boss"||n<2){chosen=e;break}}
      if(chosen){r.hitCount.set(chosen,(r.hitCount.get(chosen)||0)+1);const x=chosen.x,y=chosen.y;beams.push({x1:x,y1:y-420,x2:x,y2:y,life:.16,max:.16,color:"#fde68a",w:8});rings.push({x,y,r:48,life:.25,color:"#fef08a"});burst(x,y,"#fff7cc",10);if(bossRushMode)bossRushSource="Göklerin Hükmü";chosen.hp-=75;if(chosen.hp<=0)killEnemy(chosen);r.left--;}
      else r.left=0;
      if(r.left<=0)tr.rain=null;
    }}
  if(tr.swordQ){if(bossRushMode)bossRushSource="İlahi Savuruş";const q=tr.swordQ;q.left-=dt;if(q.left<=0){if(q.nextHit===undefined)q.nextHit=0;q.nextHit-=dt;if(q.nextHit<=0&&q.stage<q.hits){const ang=q.ang,reach=T.swordQLen;for(const e of [...enemies]){const dx=e.x-player.x,dy=e.y-player.y,d=Math.hypot(dx,dy),a=Math.atan2(dy,dx),da=Math.atan2(Math.sin(a-ang),Math.cos(a-ang));if(d<reach+e.r&&Math.abs(da)<Math.PI/2){e.hp-=T.swordQDmg*q.mult;burst(e.x,e.y,"#fbbf24",5);if(e.hp<=0)killEnemy(e)}}beams.push({x1:player.x,y1:player.y,x2:player.x+Math.cos(ang)*reach,y2:player.y+Math.sin(ang)*reach,life:.16,max:.16,color:"#fde68a",w:12});q.stage++;q.nextHit=.18}if(q.stage>=q.hits)tr.swordQ=null;}}
  if(tr.swordE){if(bossRushMode)bossRushSource="Can Çalan Saplama";const q=tr.swordE;q.left-=dt;if(q.left<=0){if(q.nextHit===undefined)q.nextHit=0;q.nextHit-=dt;if(q.nextHit<=0&&q.stage<q.hits){for(const e of [...enemies]){const dx=e.x-player.x,dy=e.y-player.y,d=Math.hypot(dx,dy),a=Math.atan2(dy,dx),da=Math.atan2(Math.sin(a-q.ang),Math.cos(a-q.ang));if(d<T.swordELen+e.r&&Math.abs(da)<.28){const dmg=T.swordEDmg*q.mult;e.hp-=dmg;player.hp=Math.min(player.maxHp,player.hp+dmg*T.swordSteal);burst(e.x,e.y,"#fde68a",6);if(e.hp<=0)killEnemy(e)}}beams.push({x1:player.x,y1:player.y,x2:player.x+Math.cos(q.ang)*T.swordELen,y2:player.y+Math.sin(q.ang)*T.swordELen,life:.12,max:.12,color:"#fff7cc",w:7});q.stage++;q.nextHit=.14}if(q.stage>=q.hits)tr.swordE=null;}}
  if(tr.ult){const u=tr.ult;if(u.phase==="flight"){u.left-=dt;if(u.left<=0)truesunLandUlt()}else if(u.phase==="impact"){u.left-=dt;if(u.left<=0)tr.ult=null}}
  if(tr.arena){if(bossRushMode)bossRushSource="Kutsal İnfaz";const a=tr.arena;a.left-=dt;
    for(const e of [...enemies]){const d=Math.hypot(e.x-a.x,e.y-a.y);if(Math.abs(d-a.radius)<e.r+9&&now/1000>(e._trArenaHit||0)){e._trArenaHit=now/1000+.65;e.hp-=T.arenaSpikeDmg;burst(e.x,e.y,"#fde68a",10);if(e.hp<=0)killEnemy(e)}}
    if(a.left<=0)tr.arena=null;
  }
  if(tr.empower>0){if(bossRushMode)bossRushSource="Ermiş Formu Aurası";tr.auraTick-=dt;if(tr.auraTick<=0){tr.auraTick=.5;for(const e of [...enemies])if(Math.hypot(e.x-player.x,e.y-player.y)<120+e.r){e.hp-=T.arenaAuraDps*.5;if(e.hp<=0)killEnemy(e)}}}
  if(tr.empowerDelay>0){tr.empowerDelay-=dt;if(tr.empowerDelay<=0){tr.empower=T.empowerLife;tr.auraTick=0;tr.formBonus=true;player.damage*=T.empowerDamage;player.attackSpeed*=T.empowerAS;say("ERMİŞ FORMU! Truesun'un gerçek gücü açığa çıktı.")}}
  else if(tr.empower>0){tr.empower=Math.max(0,tr.empower-dt);if(tr.empower===0){if(tr.formBonus){player.damage/=T.empowerDamage;player.attackSpeed/=T.empowerAS;tr.formBonus=false}/* R beklemesi ulti kullanıldığı anda başlar; burada yeniden başlatılmaz. */}}
}
