  if(typeof flames!=="undefined"&&flames)flames.length=0;
  target=null;goal.x=player.x;goal.y=player.y;
  const hp=B.hp*Math.pow(B.hpGrow,n-1);
  const b={type:"boss",kind:id,x:W/2,y:-B.r,r:B.r,maxHp:hp,hp,damage:(B.clubDmg||B.biteDmg)*Math.pow(B.dmgGrow,n-1),speed:B.speed,color:"#3f4a2e",slow:0,
    st:"intro",stT:B.intro,age:0,swingCd:1,facing:Math.PI/2,rage:false,hit:false,dir:{x:0,y:1},anim:0,
    ringNext:B.first?B.first[0]:999999,chargeNext:B.first?B.first[1]:999999,summonNext:B.first?B.first[2]:999999,ringLeft:0,ringTick:0};
  if(bossRushMode&&bossRushStats){
    let hpValue=b.hp;
    Object.defineProperty(b,"hp",{configurable:true,enumerable:true,get(){return hpValue},set(v){if(v<hpValue){const dealt=hpValue-v;bossRushStats.totalDamage+=dealt;const src=bossRushSource||"Diğer";bossRushStats.bySource[src]=(bossRushStats.bySource[src]||0)+dealt;}hpValue=v;}});
  }
  if(id==="arachmor"){b.color="#2e1065";b.eggNext=B.first[0];b.spitNext=B.first[1];b.pounceNext=B.first[2];b.biteCd=1.5;b.phase2=false}
  if(id==="malgrav"){b.color="#475569";b.qNext=2.5;b.pullNext=7;b.stoneNext=5;b.qWarn=null;b.pull=null;b.stones=[];b.rage=false;b.attackAnim=0}
  if(id==="seer"){b.color="#701a35";b.tentacleNext=SEER.tentacleCd;b.riftNext=SEER.riftCd;b.laserNext=SEER.laserCd;b.closeCd=1.2;b.tentacle=null;b.rift=null;b.laser=null;b.burnActive=false}
  enemies.push(b);
