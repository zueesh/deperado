// Düşmanların üstünde: mermiler, dron, fişek, düşen bombalar, nişan önizlemeleri
function drawMeda(){
  if(player.char!=="meda")return;
  const T=TUNE.meda;
  for(const b of bullets){
    const dr=b.kind==="drone";
    ctx.fillStyle=dr?"#bef264":"#fde047";
    ctx.beginPath();ctx.arc(b.x,b.y,dr?2.5:3.5,0,Math.PI*2);ctx.fill();
  }
  if(me.drone){
    const d=me.drone;
    ctx.fillStyle="#bef264";ctx.beginPath();ctx.arc(d.x,d.y,6,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#365314";ctx.lineWidth=2;ctx.stroke();
    ctx.save();ctx.translate(d.x,d.y);ctx.rotate(clock/50);
    ctx.strokeStyle="#ecfccb";ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(-10,0);ctx.lineTo(10,0);ctx.moveTo(0,-10);ctx.lineTo(0,10);ctx.stroke();
    ctx.restore();
  }
  if(me.flare){
    const f=me.flare,pulse=1+Math.sin(clock/80)*.18;
    ctx.strokeStyle="rgba(253,224,71,.5)";ctx.lineWidth=2;ctx.setLineDash([6,6]);
    ctx.beginPath();ctx.arc(f.x,f.y,T.eRadius,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle="rgba(253,224,71,.35)";
    ctx.beginPath();ctx.arc(f.x,f.y,T.flareR*2.2*pulse,0,Math.PI*2);ctx.fill();
    ctx.fillStyle="#fde047";
    ctx.beginPath();ctx.arc(f.x,f.y,T.flareR*pulse,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fff7ed";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(f.x,f.y,T.flareR+7,-Math.PI/2,-Math.PI/2+Math.PI*2*Math.max(0,f.left/T.eDur));ctx.stroke();
  }
  for(const b of me.bombs){
    if(b.phase!=="fall")continue;
    const p=1-b.fall/T.rFall,y=b.y-(1-p)*150;
    ctx.fillStyle="#1f2937";ctx.beginPath();ctx.arc(b.x,y,9,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#9ca3af";ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle="#ef4444";ctx.fillRect(b.x-2,y-15,4,6);
  }
  // nişan önizlemeleri
  if(me.aim==="flare"){
    ctx.strokeStyle="rgba(253,224,71,.6)";ctx.lineWidth=2;ctx.setLineDash([8,6]);
    ctx.beginPath();ctx.arc(player.x,player.y,T.eRange,0,Math.PI*2);ctx.stroke();
    const p=clampMe(mouse.x,mouse.y,T.eRange,10);
    ctx.fillStyle="rgba(250,204,21,.18)";
    ctx.beginPath();ctx.arc(p.x,p.y,T.eRadius,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fde047";ctx.stroke();ctx.setLineDash([]);
  }
  if(me.aim==="rstart"){
    ctx.strokeStyle="rgba(248,113,113,.6)";ctx.lineWidth=2;ctx.setLineDash([8,6]);
    ctx.beginPath();ctx.arc(player.x,player.y,T.rRange,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
    const p=clampMe(mouse.x,mouse.y,T.rRange,10);
    ctx.fillStyle="rgba(248,113,113,.3)";ctx.strokeStyle="#f87171";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(p.x,p.y,T.rRadius,0,Math.PI*2);ctx.fill();ctx.stroke();
  }
  if(me.aim==="rdir"&&me.rStart){
    const S0=me.rStart,ang=aimAngle(S0,mouse);
    ctx.save();ctx.translate(S0.x,S0.y);ctx.rotate(ang);
    ctx.fillStyle="rgba(248,113,113,.12)";ctx.fillRect(0,-T.rWidth/2,T.rLen,T.rWidth);
    ctx.strokeStyle="#f87171";ctx.lineWidth=2;ctx.setLineDash([10,8]);ctx.strokeRect(0,-T.rWidth/2,T.rLen,T.rWidth);ctx.setLineDash([]);
    ctx.restore();
    for(const q of strikePoints(S0,ang)){
      ctx.strokeStyle="rgba(248,113,113,.7)";ctx.lineWidth=1.5;
      ctx.beginPath();ctx.arc(q.x,q.y,T.rRadius,0,Math.PI*2);ctx.stroke();
    }
  }
}

