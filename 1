  }
  drawArachHazards();
  const b=bossState.boss;
  if(!b)return;
  if(b.kind==="arachmor"){drawArachmor(b);return}
  if(b.kind==="seer"){drawSeer(b);return}
  if(b.kind==="malgrav"){drawMalgrav(b);return}
  const f=b.facing;
  if(b.st==="cwind"){                                   // hücum yönü uyarısı
    ctx.strokeStyle="rgba(239,68,68,.65)";ctx.lineWidth=8;ctx.setLineDash([16,12]);
    ctx.beginPath();ctx.moveTo(b.x,b.y);ctx.lineTo(b.x+Math.cos(f)*1500,b.y+Math.sin(f)*1500);ctx.stroke();ctx.setLineDash([]);
  }
  if(b.st==="swing"){
    ctx.strokeStyle="rgba(239,68,68,.7)";ctx.lineWidth=3;ctx.setLineDash([8,6]);
    ctx.beginPath();ctx.arc(b.x,b.y,b.r+player.r+B.clubReach,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
  }
  if(b.rage){                                           // öfke aurası
    ctx.fillStyle="rgba(220,38,38,"+(.12+Math.sin(clock/90)*.05)+")";
    ctx.beginPath();ctx.arc(b.x,b.y,b.r+26,0,Math.PI*2);ctx.fill();
  }
  // dikenler
  for(let i=0;i<16;i++){
    const a=i*Math.PI*2/16;
    ctx.fillStyle="#d1d5db";ctx.strokeStyle="#1c1917";ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(b.x+Math.cos(a-.13)*(b.r-6),b.y+Math.sin(a-.13)*(b.r-6));
    ctx.lineTo(b.x+Math.cos(a)*(b.r+22),b.y+Math.sin(a)*(b.r+22));
    ctx.lineTo(b.x+Math.cos(a+.13)*(b.r-6),b.y+Math.sin(a+.13)*(b.r-6));
    ctx.closePath();ctx.fill();ctx.stroke();
  }
  // gövde
  ctx.fillStyle=b.rage?"#7f1d1d":"#3f4a2e";
  ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle="#1c1917";ctx.lineWidth=6;ctx.stroke();
  ctx.fillStyle="rgba(0,0,0,.22)";
  for(let i=0;i<5;i++){ctx.beginPath();ctx.arc(b.x+Math.cos(i*1.9+1)*38,b.y+Math.sin(i*1.9+1)*38,9+i*2,0,Math.PI*2);ctx.fill()}
  // sopa (sağ elinde); vururken kalkıp iner
  let ca=f+1.15;
  if(b.st==="swing")ca=f+1.15+(1-Math.max(0,b.stT)/B.clubWind)*.7;
  else if(b.anim>0)ca=f+1.85-(1-b.anim/.25)*2.9;
  const px0=b.x+Math.cos(ca)*(b.r-8),py0=b.y+Math.sin(ca)*(b.r-8);
  const px1=b.x+Math.cos(ca)*(b.r+88),py1=b.y+Math.sin(ca)*(b.r+88);
  ctx.lineCap="round";
  ctx.strokeStyle="#78350f";ctx.lineWidth=18;
  ctx.beginPath();ctx.moveTo(px0,py0);ctx.lineTo(px1,py1);ctx.stroke();
  ctx.lineCap="butt";
  ctx.fillStyle="#92400e";ctx.strokeStyle="#451a03";ctx.lineWidth=4;
  ctx.beginPath();ctx.arc(px1,py1,25,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle="#9ca3af";
  for(let i=0;i<6;i++){ctx.beginPath();ctx.arc(px1+Math.cos(i*1.05)*17,py1+Math.sin(i*1.05)*17,4,0,Math.PI*2);ctx.fill()}
  // kafa: şerit şerit izler ve kızgın gözler
  const hx=b.x+Math.cos(f)*(b.r*.55),hy=b.y+Math.sin(f)*(b.r*.55);
  ctx.fillStyle=b.rage?"#991b1b":"#556b2f";
  ctx.beginPath();ctx.arc(hx,hy,30,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle="#1c1917";ctx.lineWidth=4;ctx.stroke();
  ctx.save();ctx.translate(hx,hy);ctx.rotate(f);
  ctx.strokeStyle="#e5e7eb";ctx.lineWidth=2.5;
  for(let i=-1;i<=1;i++){ctx.beginPath();ctx.moveTo(-24,i*9-10);ctx.lineTo(18,i*9+8);ctx.stroke()}   // yara izleri
  ctx.strokeStyle="#fca5a5";ctx.lineWidth=1.5;
  for(let i=-1;i<=1;i++){ctx.beginPath();ctx.moveTo(-22,i*9-8);ctx.lineTo(20,i*9+10);ctx.stroke()}
  ctx.fillStyle="#fde047";
  ctx.beginPath();ctx.arc(16,-9,4.5,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(16,9,4.5,0,Math.PI*2);ctx.fill();
  ctx.fillStyle="#dc2626";
  ctx.beginPath();ctx.arc(17,-9,2,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(17,9,2,0,Math.PI*2);ctx.fill();
  ctx.restore();
}

/* ---------- ARHAS ---------- */
const SAND="#e0b872";

function cancelAimAh(){
  if(ah)ah.aim=null;
  canvas.classList.remove("aiming");
  canvas.classList.remove("aimingYellow");
}

// Oto atak: kumdan yumruk
function punch(e){
  if(!enemies.includes(e))return;
  ah.punchT=.14;
  ah.fists.push({x:e.x,y:e.y,t:.25,max:.25,ang:Math.atan2(e.y-player.y,e.x-player.x)});
  burst(e.x,e.y,SAND,8);
  e.hp-=player.damage;
  if(e.hp<=0)killEnemy(e);
}

function allyHit(dmg){
  if(!ah||!ah.ally)return;
  ah.ally.hp-=dmg;
  burst(ah.ally.x,ah.ally.y,SAND,3);
  if(ah.ally.hp<=0)endAlly();
}

function endAlly(){
  if(!ah.ally)return;
  burst(ah.ally.x,ah.ally.y,SAND,34);
  rings.push({x:ah.ally.x,y:ah.ally.y,r:ah.ally.r+30,life:.4,color:SAND});
  ah.ally=null;
  cooldowns.r=clock/1000+TUNE.arhas.rCd;               // bekleme Skaruun gidince başlar
}

function launchTornado(start,ang){
  const T=TUNE.arhas;
  ah.torn={x:start.x,y:start.y,dx:Math.cos(ang),dy:Math.sin(ang),left:T.wDist,a:0};
  cooldowns.w=clock/1000+T.wCd;
  cancelAimAh();
  burst(start.x,start.y,SAND,20);
  say("Kasırga!");
}

function sandFist(){
  const T=TUNE.arhas,f=player.facing,cs=Math.cos(f),sn=Math.sin(f);
  let hit=0;
  for(const e of [...enemies]){
    const dx=e.x-player.x,dy=e.y-player.y;
    const fwd=dx*cs+dy*sn,side=-dx*sn+dy*cs;
    if(fwd>-e.r&&fwd<T.eLen+e.r&&Math.abs(side)<T.eWid/2+e.r){
      hit++;
      e.hp-=T.eDmg;
      e.slow=Math.max(e.slow||0,T.eSlowT);e.slowMul=1-T.eSlow;
      burst(e.x,e.y,SAND,6);
      if(e.hp<=0)killEnemy(e);
    }
  }
  ah.fists.push({x:player.x+cs*T.eLen/2,y:player.y+sn*T.eLen/2,t:.3,max:.3,ang:f,big:true});
  player.kb={vx:-cs*T.eRecoil/T.eRecoilT,vy:-sn*T.eRecoil/T.eRecoilT,t:T.eRecoilT,root:false};   // yumruğun tepmesi seni geri atar
  burst(player.x+cs*T.eLen*.6,player.y+sn*T.eLen*.6,SAND,14);
}

function useArhasSkill(key,now){
  const T=TUNE.arhas;
  const ready=(cooldowns[key]||0)<=now;
  if(ah.channel>0)return;                                // Skaruun'u çağırırken başka yetenek yok
  if(key==="q"){
    cancelAimAh();
    if(ah.clone){                                          // klona ışınlan, klon yok olur, %30 iyileş
      if(player.rooted>0||player.kb)return;
      burst(player.x,player.y,SAND,18);
      player.x=ah.clone.x;player.y=ah.clone.y;
      goal.x=player.x;goal.y=player.y;
      burst(player.x,player.y,SAND,22);
      rings.push({x:player.x,y:player.y,r:44,life:.3,color:SAND});
      ah.clone=null;
      player.hp=Math.min(player.maxHp,player.hp+player.maxHp*T.qHeal);
      cooldowns.q=now+T.qCd;
      say("Klona ışınlandın! Canın %"+nr(T.qHeal*100)+" yenilendi.");
      return;
    }
    if(!ready)return;
    ah.clone={x:player.x,y:player.y,left:T.qLife};
    cooldowns.q=1e9;                                       // bekleme klon bitince başlar
    burst(player.x,player.y,SAND,16);
    say("Kum klonu bırakıldı! "+T.qLife+" sn içinde tekrar Q'ya bas.");
    return;
  }
  if(key==="w"){
    if(ah.aim==="wstart"||ah.aim==="wdir"){cancelAimAh();say("Nişan iptal edildi.");return}
    cancelAimAh();
    if(!ready)return;
    ah.aim="wstart";
    canvas.classList.add("aiming");canvas.classList.add("aimingYellow");
    say("Kasırganın başlayacağı noktaya tıkla, sonra yönü seç (iptal: W / Esc / sağ tık)");
    return;
  }
  if(key==="e"){
    cancelAimAh();
    if(!ready)return;
    cooldowns.e=now+T.eCd;
    sandFist();
    return;
  }
  if(key==="r"){
    cancelAimAh();
    if(!ready||ah.ally)return;
    ah.channel=T.rChannel;
    target=null;goal.x=player.x;goal.y=player.y;
    say("Odaklanıyorsun... Skaruun uyanıyor!");
  }
}

function summonSkaruun(){
  const T=TUNE.arhas,f=player.facing;
  ah.ally={x:Math.max(40,Math.min(W-40,player.x+Math.cos(f)*80)),y:Math.max(40,Math.min(H-40,player.y+Math.sin(f)*80)),
    hp:T.rHp,max:T.rHp,left:T.rDur,r:T.rR,atkCd:0,emerge:.6,swing:0,face:f};
  cooldowns.r=1e9;                                         // bekleme Skaruun gidince başlar
  burst(ah.ally.x,ah.ally.y,SAND,30);
  rings.push({x:ah.ally.x,y:ah.ally.y,r:70,life:.5,color:SAND});
  say("SKARUUN!");
}

function updateArhas(dt){
  const T=TUNE.arhas;
  for(const fi of [...ah.fists]){fi.t-=dt;if(fi.t<=0)ah.fists.splice(ah.fists.indexOf(fi),1)}
  ah.punchT=Math.max(0,ah.punchT-dt);

  // pasif: 3 sn hasar yemezsen 1.5 sn'de bir azami canın %2'si
  ah.calm+=dt;
  if(ah.calm>=T.calmT){
    ah.regenT-=dt;
    if(ah.regenT<=0){
      ah.regenT=T.regenTick;
      if(player.hp<player.maxHp){
        player.hp=Math.min(player.maxHp,player.hp+player.maxHp*T.regenFrac);
        burst(player.x,player.y,"#bef264",4);
      }
    }
  }else ah.regenT=0;

  // Q: klon süresi dolunca bekleme başlar
  if(ah.clone){
    ah.clone.left-=dt;
    if(ah.clone.left<=0){burst(ah.clone.x,ah.clone.y,SAND,16);ah.clone=null;cooldowns.q=clock/1000+T.qCd}
  }

  // W: kasırga ilerler, dışındakileri merkeze çeker, bitince merkezdekiler hareketsiz kalır
  if(ah.torn){
    const tr=ah.torn;
    const step=Math.min(T.wSpeed*dt,tr.left);
    tr.x+=tr.dx*step;tr.y+=tr.dy*step;tr.left-=step;tr.a+=dt;
    for(const e of enemies){
      if(e.type==="boss"||e.type==="egg")continue;
      const d=Math.hypot(tr.x-e.x,tr.y-e.y);
      if(d<T.wOuter+e.r&&d>1){
        const pull=Math.min(T.wPull*dt,d);
        e.x+=(tr.x-e.x)/d*pull;e.y+=(tr.y-e.y)/d*pull;
      }
    }
    if(tr.left<=0){
      rings.push({x:tr.x,y:tr.y,r:T.wInner+30,life:.4,color:SAND});
      burst(tr.x,tr.y,SAND,34);
      for(const e of enemies){
        if(e.type==="egg")continue;
        if(Math.hypot(tr.x-e.x,tr.y-e.y)<T.wInner+e.r)e.stun=T.wFreeze;
      }
      ah.torn=null;
    }
  }

  // R: odaklanma ve Skaruun
  if(ah.channel>0){
    ah.channel-=dt;
    goal.x=player.x;goal.y=player.y;target=null;
    if(ah.channel<=0){ah.channel=0;summonSkaruun()}
  }
  if(ah.ally){
    const a=ah.ally;
    a.left-=dt;
    if(a.emerge>0){a.emerge-=dt}
    else{
      let best=null,bd=1e9;
      for(const e of enemies){const d=Math.hypot(e.x-a.x,e.y-a.y);if(d<bd){bd=d;best=e}}   // en yakın düşmana
      a.swing=Math.max(0,a.swing-dt);
      if(best){
        const reach=a.r+best.r+8;
        a.face=Math.atan2(best.y-a.y,best.x-a.x);
        if(bd>reach){a.x+=Math.cos(a.face)*T.rSpeed*dt;a.y+=Math.sin(a.face)*T.rSpeed*dt}
        a.atkCd-=dt;
        if(bd<=reach+4&&a.atkCd<=0){
          a.atkCd=1/T.rAs;a.swing=.18;
          burst(best.x,best.y,SAND,6);
          best.hp-=T.rDmg;
          if(best.hp<=0)killEnemy(best);
        }
      }else{                                              // düşman yoksa seni takip eder
        const d=Math.hypot(player.x-a.x,player.y-a.y);
        a.face=Math.atan2(player.y-a.y,player.x-a.x);
        if(d>110){a.x+=Math.cos(a.face)*T.rSpeed*dt;a.y+=Math.sin(a.face)*T.rSpeed*dt}
      }
    }
    if(ah.ally&&a.left<=0)endAlly();
  }
}

function drawArhasHand(){
  // kum rengi gövde üstünde iki yumruk; vururken yumruk öne uzanır
  ctx.save();ctx.translate(player.x,player.y);ctx.rotate(player.facing);
  const ext=ah.punchT>0?14:0;
  ctx.fillStyle="#c9a35c";ctx.strokeStyle="#7c5a1e";ctx.lineWidth=2;
  ctx.beginPath();ctx.arc(14+ext,-9,7,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.beginPath();ctx.arc(14,9,7,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.restore();
}

function sandGrains(cx,cy,r,n,speed){
  ctx.fillStyle="rgba(224,184,114,.75)";
  for(let i=0;i<n;i++){
    const a=clock/speed+i*6.283/n,rr=r*(.45+.55*((i*37)%10)/10);
    ctx.beginPath();ctx.arc(cx+Math.cos(a)*rr,cy+Math.sin(a)*rr,2.5,0,Math.PI*2);ctx.fill();
  }
}

function drawArhas(){
  if(!ah)return;
  const T=TUNE.arhas;
  // yumruk efektleri
  for(const fi of ah.fists){
    const p=1-fi.t/fi.max;
    ctx.globalAlpha=Math.max(0,fi.t/fi.max);
    if(fi.big){
      ctx.save();ctx.translate(player.x,player.y);ctx.rotate(fi.ang);
      ctx.fillStyle="rgba(201,163,92,.55)";ctx.fillRect(0,-T.eWid/2,T.eLen,T.eWid);
      ctx.strokeStyle="#7c5a1e";ctx.lineWidth=3;ctx.strokeRect(0,-T.eWid/2,T.eLen,T.eWid);
      ctx.fillStyle="#c9a35c";ctx.beginPath();ctx.arc(T.eLen*(.45+.5*p),0,34,0,Math.PI*2);ctx.fill();ctx.stroke();   // dev yumruk
      ctx.fillStyle="#b8904a";for(let i=0;i<4;i++){ctx.beginPath();ctx.arc(T.eLen*(.45+.5*p)+14,-18+i*12,6,0,Math.PI*2);ctx.fill()}
      ctx.restore();
    }else{
      ctx.fillStyle="#c9a35c";ctx.beginPath();ctx.arc(fi.x,fi.y,10+p*8,0,Math.PI*2);ctx.fill();
    }
    ctx.globalAlpha=1;
  }
  // kum klonu
  if(ah.clone){
    const c=ah.clone,pu=1+Math.sin(clock/160)*.05;
    ctx.globalAlpha=.55;
    ctx.fillStyle=SAND;ctx.beginPath();ctx.arc(c.x,c.y,player.r*pu,0,Math.PI*2);ctx.fill();
    ctx.globalAlpha=1;
    ctx.strokeStyle="#7c5a1e";ctx.lineWidth=2;ctx.setLineDash([4,3]);ctx.stroke();ctx.setLineDash([]);
    sandGrains(c.x,c.y,player.r+8,8,260);
    ctx.strokeStyle="rgba(224,184,114,.9)";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(c.x,c.y,player.r+10,-Math.PI/2,-Math.PI/2+Math.PI*2*Math.max(0,c.left/T.qLife));ctx.stroke();
  }
  // kasırga: iç içe iki çember
  if(ah.torn){
    const tr=ah.torn;
    for(const [rr,k,sp] of [[T.wOuter,.3,1],[T.wInner,.55,-1.6]]){
      ctx.fillStyle="rgba(201,163,92,"+k*.6+")";ctx.beginPath();ctx.arc(tr.x,tr.y,rr,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle="rgba(124,90,30,.9)";ctx.lineWidth=3;
      for(let i=0;i<3;i++){
        const a0=tr.a*3*sp+i*2.09;
        ctx.beginPath();ctx.arc(tr.x,tr.y,rr*(.7+.1*i),a0,a0+1.3);ctx.stroke();
      }
    }
    sandGrains(tr.x,tr.y,T.wOuter,14,170);
  }
  // Skaruun: kumdan dev dost
  if(ah.ally){
    const a=ah.ally,rise=a.emerge>0?1-a.emerge/.6:1;
    if(a.emerge>0){                                        // yerden çıkarken çatlaklar
      ctx.strokeStyle="rgba(92,64,20,.8)";ctx.lineWidth=3;
      for(let i=0;i<8;i++){const g=i*.785;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(a.x+Math.cos(g)*(30+rise*40),a.y+Math.sin(g)*(30+rise*40));ctx.stroke()}
    }
    ctx.save();ctx.translate(a.x,a.y);ctx.scale(.4+.6*rise,.4+.6*rise);ctx.rotate(a.face);
    const bob=Math.sin(clock/140)*2;
    // omuzlar ve yumruklar
    const sw=a.swing>0?1:0;
    ctx.fillStyle="#b8904a";ctx.strokeStyle="#5c4014";ctx.lineWidth=4;
    ctx.beginPath();ctx.arc(10+sw*16,-a.r*.95,15,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.beginPath();ctx.arc(10,a.r*.95+bob,15,0,Math.PI*2);ctx.fill();ctx.stroke();
    // gövde
    ctx.fillStyle="#c9a35c";ctx.beginPath();ctx.arc(0,0,a.r,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.strokeStyle="rgba(92,64,20,.7)";ctx.lineWidth=2.5;                                      // çatlaklar
    ctx.beginPath();ctx.moveTo(-18,-10);ctx.lineTo(-6,-2);ctx.lineTo(-14,10);ctx.moveTo(4,-16);ctx.lineTo(10,-4);ctx.lineTo(2,8);ctx.stroke();
    // kafa
    ctx.fillStyle="#d6b36a";ctx.strokeStyle="#5c4014";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(a.r*.55,0,15,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.fillStyle="#fde047";ctx.beginPath();ctx.arc(a.r*.55+8,-5,3.2,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(a.r*.55+8,5,3.2,0,Math.PI*2);ctx.fill();
    ctx.restore();
    sandGrains(a.x,a.y,a.r+10,10,320);
    // can çubuğu ve kalan süre
    const bw=70;
    ctx.fillStyle="rgba(0,0,0,.5)";ctx.fillRect(a.x-bw/2,a.y-a.r-22,bw,7);
    ctx.fillStyle="#84cc16";ctx.fillRect(a.x-bw/2,a.y-a.r-22,bw*Math.max(0,a.hp/a.max),7);
    ctx.strokeStyle="rgba(224,184,114,.9)";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(a.x,a.y,a.r+9,-Math.PI/2,-Math.PI/2+Math.PI*2*Math.max(0,a.left/T.rDur));ctx.stroke();
  }
  // odaklanma
  if(ah.channel>0&&player.char==="arhas"){
    ctx.strokeStyle="rgba(224,184,114,.9)";ctx.lineWidth=3;
    const p=1-ah.channel/T.rChannel;
    ctx.beginPath();ctx.arc(player.x,player.y,player.r+8+p*30,0,Math.PI*2);ctx.stroke();
    sandGrains(player.x,player.y,player.r+30,12,120);
  }
  // nişan önizlemesi
  if(player.char==="arhas"&&ah.aim){
    ctx.lineWidth=2;ctx.setLineDash([8,6]);ctx.strokeStyle="rgba(224,184,114,.8)";
    if(ah.aim==="wstart"){
      ctx.beginPath();ctx.arc(player.x,player.y,T.wRange,0,Math.PI*2);ctx.stroke();
      const q=clampMe(mouse.x,mouse.y,T.wRange,10);
      ctx.beginPath();ctx.arc(q.x,q.y,T.wOuter,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.arc(q.x,q.y,T.wInner,0,Math.PI*2);ctx.stroke();
    }else if(ah.aim==="wdir"&&ah.wStart){
      const S0=ah.wStart,ang=aimAngle(S0,mouse),ex=S0.x+Math.cos(ang)*T.wDist,ey=S0.y+Math.sin(ang)*T.wDist;
      ctx.beginPath();ctx.moveTo(S0.x,S0.y);ctx.lineTo(ex,ey);ctx.stroke();
      ctx.beginPath();ctx.arc(S0.x,S0.y,T.wOuter,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.arc(ex,ey,T.wInner,0,Math.PI*2);ctx.stroke();
    }
    ctx.setLineDash([]);
  }
}

/* ---------- AZURON ---------- */
function cancelAimAz(){
  if(az){az.aim=null;az.qHeld=false}
  canvas.classList.remove("aiming");
  canvas.classList.remove("aimingYellow");
}

function azBolt(x1,y1,x2,y2,life,color,w){az.bolts.push({x1,y1,x2,y2,life,max:life,color:color||"#fde047",w:w||3})}

// Pasif: her yük 6 saniye sonra alan hasarıyla patlar; patlama yüklü düşmanlara zincirlenir.
function azCharge(e){
  const T=TUNE.azuron;
  e.chargeTimes=e.chargeTimes||[];
  if(e.chargeTimes.length<T.maxCharge)e.chargeTimes.push(T.chargeLife);
  e.charge=e.chargeTimes.length;
  e.chargeT=Math.max(...e.chargeTimes);
  return false;
}

function azDamage(e,dmg){
  e.hp-=dmg;
  if(e.hp<=0){killEnemy(e);return true}
  return azCharge(e);
}

function azDetonate(e){
  if(!enemies.includes(e))return;
  const T=TUNE.azuron,hit=new Set([e]);
  const damageArea=(center)=>{
    azBolt(center.x,center.y-90,center.x,center.y,.25,"#fef9c3",5);
    burst(center.x,center.y,"#fde047",14);
    rings.push({x:center.x,y:center.y,r:T.chargeRadius,life:.35,color:"#fde047"});
    for(const other of [...enemies]){
      if(Math.hypot(other.x-center.x,other.y-center.y)<=T.chargeRadius+other.r){
        other.hp-=T.burstDmg;
        if(other.hp<=0)killEnemy(other);
      }
    }
  };
  e.chargeTimes=[];e.charge=0;e.chargeT=0;damageArea(e);
  let from=e;
  for(let i=0;i<T.chargeBounces;i++){
    let best=null;
    for(const candidate of enemies){
      if(hit.has(candidate)||!(candidate.chargeTimes?.length||candidate.charge||0))continue;
      if(!best||Math.hypot(candidate.x-from.x,candidate.y-from.y)<Math.hypot(best.x-from.x,best.y-from.y))best=candidate;
    }
    if(!best)break;
    hit.add(best);azBolt(from.x,from.y,best.x,best.y,.3,"#fde047",4);
    best.chargeTimes=[];best.charge=0;best.chargeT=0;damageArea(best);from=best;
  }
}

function fireZap(e){
  if(!enemies.includes(e))return;
  azBolt(player.x+Math.cos(player.facing)*24,player.y+Math.sin(player.facing)*24,e.x,e.y,.11,"#fde047",3);
  burst(e.x,e.y,"#fde047",3);
  azDamage(e,player.damage);
}

function fireQ(pt){
  const T=TUNE.azuron;
  const dx=pt.x-player.x,dy=pt.y-player.y,d=Math.hypot(dx,dy)||1;
  az.proj.push({x:player.x,y:player.y,dx:dx/d,dy:dy/d,left:T.qRange});
  player.facing=Math.atan2(dy,dx);
  cooldowns.q=clock/1000+T.qCd;
  cancelAimAz();
  say("Yıldırım!");
}

// Q ilk hedefe vurur; 200 piksel içindeki yüklü düşmanlara en fazla 5 kez seker.
function zapChain(first){
  const T=TUNE.azuron,hit=new Set([first]);
  let from={x:first.x,y:first.y};
  azDamage(first,T.qDmg);
  for(let i=0;i<T.qBounces;i++){
    let best=null,bd=T.qBounceRange;
    for(const e of enemies){
      if(hit.has(e)||!(e.chargeTimes?.length||e.charge||0))continue;
      const d=Math.hypot(e.x-first.x,e.y-first.y);
      if(d<=T.qBounceRange&&d<bd+0.001){bd=d;best=e}
    }
    if(!best)break;
    azBolt(from.x,from.y,best.x,best.y,.3,"#fde047",4);
    hit.add(best);from={x:best.x,y:best.y};
    azDamage(best,T.qBounceDmg);
  }
}

function placeStrike(pt){
  const T=TUNE.azuron,q=clampMe(pt.x,pt.y,T.wRange,10);
  az.strikes.push({x:q.x,y:q.y,t:T.wDelay});
  cooldowns.w=clock/1000+T.wCd;
  cancelAimAz();
  say("Gök gürlüyor... "+T.wDelay+" sn sonra yıldırım düşecek!");
}

function launchOrb(start,ang){
  const T=TUNE.azuron;
  az.orb={x:start.x,y:start.y,vx:Math.cos(ang)*T.rSpeed,vy:Math.sin(ang)*T.rSpeed,left:T.rLife};
  cooldowns.r=clock/1000+T.rCd;                  // küre atılınca ulti kullanılmış sayılır, bekleme başlar
  cancelAimAz();
  burst(start.x,start.y,"#fde047",20);
  say("Yıldırım küresi bırakıldı!");
}

// Yük Çek: haritadaki tüm yükleri hasarsız siler, her yük için eksik canının %8'ini yeniler
function azuronE(now){
  const T=TUNE.azuron;
  let total=0;
  for(const e of enemies){
    if((e.charge||0)>0){
      total+=e.charge;e.charge=0;e.chargeT=0;e.chargeTimes=[];
      azBolt(e.x,e.y,player.x,player.y,.35,"#fde047",3);
    }
  }
  if(total===0){say("Üzerinde yük olan düşman yok.");return}
  for(let i=0;i<total;i++)player.hp=Math.min(player.maxHp,player.hp+(player.maxHp-player.hp)*T.eHeal);
  cooldowns.e=now+T.eCd;
  burst(player.x,player.y,"#fde047",18);
  rings.push({x:player.x,y:player.y,r:50,life:.3,color:"#86efac"});
  say(total+" yük çekildi, canın yenilendi!");
}

// fromKey: tuşla mı çağrıldı (Q'ya basılı tutma), düğmeyle mi (dokunmatik/fare: Q'ya bir kez dokun, bir kez daha dokunursan iptal)
function useAzuronSkill(key,now,fromKey){
  const ready=(cooldowns[key]||0)<=now;
  if(key==="q"){
    if(az.aim==="q"){if(!fromKey){cancelAimAz();say("Yıldırım iptal edildi.")}return}
    cancelAimAz();
    if(!ready)return;
    az.aim="q";az.qHeld=!!fromKey;
    canvas.classList.add("aiming");canvas.classList.add("aimingYellow");
    say(fromKey?"Q'ya basılı tut, tıkla: yıldırım o yöne gider (bırakırsan iptal)":"Yıldırımın gideceği yöne tıkla (iptal: Q / Esc)");
    return;
  }
  if(key==="w"){
    if(az.aim==="w"){cancelAimAz();say("Nişan iptal edildi.");return}
    cancelAimAz();
    if(!ready)return;
    az.aim="w";
    canvas.classList.add("aiming");canvas.classList.add("aimingYellow");
    say("Yıldırımın düşeceği noktaya tıkla (iptal: W / Esc / sağ tık)");
    return;
  }
  if(key==="e"){
    cancelAimAz();
    if(!ready)return;
    azuronE(now);
    return;
  }
  if(key==="r"){
    if(az.aim==="rstart"||az.aim==="rdir"){cancelAimAz();say("Nişan iptal edildi.");return}
    cancelAimAz();
    if(!ready||az.orb)return;
    az.aim="rstart";
    canvas.classList.add("aiming");canvas.classList.add("aimingYellow");
    say("Kürenin başlayacağı noktaya tıkla, sonra yönü seç (iptal: R / Esc / sağ tık)");
  }
}

function updateAzuron(dt){
  const T=TUNE.azuron;
  for(const b of [...az.bolts]){b.life-=dt;if(b.life<=0)az.bolts.splice(az.bolts.indexOf(b),1)}
  // Her yük kendi 6 saniyelik süresinin sonunda patlar.
  for(const e of [...enemies]){
    if((e.chargeTimes?.length||0)>0){
      e.chargeTimes=e.chargeTimes.map(t=>t-dt);
      const expired=e.chargeTimes.some(t=>t<=0);
      e.chargeTimes=e.chargeTimes.filter(t=>t>0);
      e.charge=e.chargeTimes.length;e.chargeT=e.chargeTimes.length?Math.max(...e.chargeTimes):0;
      if(expired)azDetonate(e);
    }else if((e.charge||0)>0){e.charge=0;e.chargeT=0}
    if(e.orbHit>0)e.orbHit-=dt;
  }
  // Q: uçan yıldırım
  for(const p of [...az.proj]){
    const step=T.qSpeed*dt;
    p.x+=p.dx*step;p.y+=p.dy*step;p.left-=step;
    let hit=null;
    for(const e of enemies){if(Math.hypot(e.x-p.x,e.y-p.y)<e.r+8){hit=e;break}}
    if(hit){az.proj.splice(az.proj.indexOf(p),1);zapChain(hit);continue}
    if(p.left<=0||p.x<-20||p.x>W+20||p.y<-20||p.y>H+20)az.proj.splice(az.proj.indexOf(p),1);
  }
  // W: gecikmeli yıldırım
  for(const st of [...az.strikes]){
    st.t-=dt;
    if(st.t<=0){
      az.strikes.splice(az.strikes.indexOf(st),1);
      azBolt(st.x,st.y-420,st.x,st.y,.3,"#fef9c3",8);
      rings.push({x:st.x,y:st.y,r:T.wDia/2+14,life:.35,color:"#fde047"});
      burst(st.x,st.y,"#fde047",24);
      for(const e of [...enemies]){
        if(Math.hypot(e.x-st.x,e.y-st.y)<T.wDia/2+e.r){e.stun=T.wStun;azDamage(e,T.wDmg)}
      }
    }
  }
  // R: seken yıldırım küresi
  if(az.orb){
    const o=az.orb,r=T.rDia/2;
    o.left-=dt;
    o.x+=o.vx*dt;o.y+=o.vy*dt;
    if(o.x-r<0){o.x=r;o.vx=Math.abs(o.vx)}
    if(o.x+r>W){o.x=W-r;o.vx=-Math.abs(o.vx)}
    if(o.y-r<0){o.y=r;o.vy=Math.abs(o.vy)}
    if(o.y+r>H){o.y=H-r;o.vy=-Math.abs(o.vy)}
    for(const e of [...enemies]){
      if(e.orbHit>0)continue;
      if(Math.hypot(e.x-o.x,e.y-o.y)<r+e.r){
        e.orbHit=T.rHitGap;
        burst(e.x,e.y,"#fde047",6);
        if(azDamage(e,T.rDmg))cooldowns.r-=T.rKillCdr;     // öldürürse ulti beklemesi 1 sn azalır
      }
    }
    if(o.left<=0){az.orb=null;burst(o.x,o.y,"#fde047",20)}
  }
}

function drawAzuronHand(){
  // sarı çerçeve, şapka ve asa
  ctx.strokeStyle="#facc15";ctx.lineWidth=3;
  ctx.beginPath();ctx.arc(player.x,player.y,player.r+1,0,Math.PI*2);ctx.stroke();
  ctx.save();ctx.translate(player.x,player.y);ctx.rotate(player.facing);
  ctx.strokeStyle="#a16207";ctx.lineWidth=4;ctx.lineCap="round";
  ctx.beginPath();ctx.moveTo(4,9);ctx.lineTo(30,9);ctx.stroke();           // asa
  ctx.lineCap="butt";
  ctx.fillStyle="#fde047";ctx.beginPath();ctx.arc(31,9,5+Math.sin(clock/90),0,Math.PI*2);ctx.fill();   // asanın ucundaki yıldırım taşı
  ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(31,9,2,0,Math.PI*2);ctx.fill();
  ctx.restore();
  ctx.fillStyle="#e5e7eb";ctx.strokeStyle="#facc15";ctx.lineWidth=2;      // şapka (yukarıdan: geniş kenar)
  ctx.beginPath();ctx.arc(player.x,player.y,10,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle="#facc15";ctx.beginPath();ctx.arc(player.x,player.y,3.5,0,Math.PI*2);ctx.fill();
}

function drawAzuron(){
  if(!enemies)return;
  // düşmanların üzerindeki yıldırım yükleri (sadece Azuron'dayken görünür)
  if(player.char==="azuron"){
    for(const e of enemies){
      const c=e.charge||0;
      if(c<=0)continue;
      if(c>=TUNE.azuron.maxCharge){
        ctx.strokeStyle="rgba(253,224,71,"+(.5+Math.sin(clock/70)*.3)+")";ctx.lineWidth=3;
        ctx.beginPath();ctx.arc(e.x,e.y,e.r+8,0,Math.PI*2);ctx.stroke();
      }
      for(let i=0;i<c;i++){
        const ox=(i-(c-1)/2)*10,oy=-e.r-14-Math.abs(Math.sin(clock/120+i))*2;
        ctx.fillStyle="#fde047";ctx.strokeStyle="#a16207";ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(e.x+ox+2,e.y+oy-6);ctx.lineTo(e.x+ox-3,e.y+oy+1);ctx.lineTo(e.x+ox,e.y+oy+1);ctx.lineTo(e.x+ox-2,e.y+oy+7);ctx.lineTo(e.x+ox+4,e.y+oy-1);ctx.lineTo(e.x+ox+1,e.y+oy-1);ctx.closePath();ctx.fill();ctx.stroke();
      }
    }
  }
  if(!az)return;
  const T=TUNE.azuron;
  // W: yıldırım düşmeden önceki uyarı
  for(const st of az.strikes){
    const p=1-st.t/T.wDelay;
    ctx.fillStyle="rgba(250,204,21,"+(.1+p*.25)+")";
    ctx.beginPath();ctx.arc(st.x,st.y,T.wDia/2,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#facc15";ctx.lineWidth=2;ctx.setLineDash([6,5]);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle="rgba(250,204,21,.45)";ctx.beginPath();ctx.arc(st.x,st.y,T.wDia/2*p,0,Math.PI*2);ctx.fill();
  }
  // uçan yıldırım
  for(const pr of az.proj){
    ctx.strokeStyle="#fef9c3";ctx.lineWidth=5;ctx.lineCap="round";
    ctx.beginPath();ctx.moveTo(pr.x-pr.dx*22,pr.y-pr.dy*22);ctx.lineTo(pr.x,pr.y);ctx.stroke();
    ctx.strokeStyle="#fde047";ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(pr.x-pr.dx*34,pr.y-pr.dy*34+4);ctx.lineTo(pr.x-pr.dx*12,pr.y-pr.dy*12-4);ctx.lineTo(pr.x,pr.y);ctx.stroke();
    ctx.lineCap="butt";
  }
  // yıldırım küresi
  if(az.orb){
    const o=az.orb,r=T.rDia/2;
    ctx.fillStyle="rgba(253,224,71,.18)";ctx.beginPath();ctx.arc(o.x,o.y,r,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="rgba(253,224,71,.8)";ctx.lineWidth=3;ctx.stroke();
    ctx.fillStyle="#fef9c3";ctx.beginPath();ctx.arc(o.x,o.y,r*.45,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#fde047";ctx.lineWidth=2;
    for(let i=0;i<5;i++){                         // kürenin içinde dolaşan şimşekler
      const a=clock/180+i*1.26;
      ctx.beginPath();ctx.moveTo(o.x+Math.cos(a)*r*.3,o.y+Math.sin(a)*r*.3);
      ctx.lineTo(o.x+Math.cos(a+.4)*r*.7,o.y+Math.sin(a+.4)*r*.7);ctx.lineTo(o.x+Math.cos(a-.2)*r*.95,o.y+Math.sin(a-.2)*r*.95);ctx.stroke();
    }
  }
  // şimşek çizgileri
  for(const b of az.bolts){
    ctx.globalAlpha=Math.max(0,b.life/b.max);
    ctx.strokeStyle=b.color;ctx.lineWidth=b.w;ctx.lineCap="round";
    const mx=(b.x1+b.x2)/2+(Math.sin(clock/40)*8),my=(b.y1+b.y2)/2+(Math.cos(clock/50)*8);
    ctx.beginPath();ctx.moveTo(b.x1,b.y1);ctx.lineTo(mx,my);ctx.lineTo(b.x2,b.y2);ctx.stroke();
  }
  ctx.globalAlpha=1;ctx.lineCap="butt";
  // nişan önizlemeleri
  if(player.char==="azuron"&&az.aim){
    ctx.lineWidth=2;ctx.setLineDash([8,6]);
    if(az.aim==="q"){
      const ang=Math.atan2(mouse.y-player.y,mouse.x-player.x);
      ctx.strokeStyle="rgba(253,224,71,.8)";
      ctx.beginPath();ctx.moveTo(player.x,player.y);ctx.lineTo(player.x+Math.cos(ang)*T.qRange,player.y+Math.sin(ang)*T.qRange);ctx.stroke();
    }else if(az.aim==="w"){
      ctx.strokeStyle="rgba(253,224,71,.6)";
      ctx.beginPath();ctx.arc(player.x,player.y,T.wRange,0,Math.PI*2);ctx.stroke();
      const q=clampMe(mouse.x,mouse.y,T.wRange,10);
      ctx.fillStyle="rgba(250,204,21,.25)";ctx.beginPath();ctx.arc(q.x,q.y,T.wDia/2,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle="#facc15";ctx.stroke();
    }else if(az.aim==="rstart"){
      ctx.strokeStyle="rgba(253,224,71,.6)";
      ctx.beginPath();ctx.arc(player.x,player.y,T.rRange,0,Math.PI*2);ctx.stroke();
      const q=clampMe(mouse.x,mouse.y,T.rRange,10);
      ctx.fillStyle="rgba(253,224,71,.25)";ctx.beginPath();ctx.arc(q.x,q.y,T.rDia/2,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle="#facc15";ctx.stroke();
    }else if(az.aim==="rdir"&&az.rStart){
      const S0=az.rStart,ang=aimAngle(S0,mouse);
      ctx.fillStyle="rgba(253,224,71,.25)";ctx.beginPath();ctx.arc(S0.x,S0.y,T.rDia/2,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle="#facc15";ctx.beginPath();ctx.moveTo(S0.x,S0.y);ctx.lineTo(S0.x+Math.cos(ang)*420,S0.y+Math.sin(ang)*420);ctx.stroke();
    }
    ctx.setLineDash([]);
  }
}

/* ---------- HARİTA TEMALARI ---------- */
// 20 sn mola, 20 sn aktif tema, sürekli rastgele. Kötü temalar iyilerden daha sık gelir.
const MAPFX={
  breakT:20,activeT:20,badChance:.7,           // mola süresi, aktif süre, kötü tema çıkma ihtimali
  poolCount:[5,7],poolRadius:[45,85],poolWarn:.9,   // göl sayısı (en az, en çok), göl boyutu, çıkmadan önce uyarı süresi
  lavaDmg:5,lavaTick:.4,                       // lav (ve öfke iksiri): hasar, hasar aralığı (sadece sen etkilenirsin)
  iceSlow:.3,iceFreezeAfter:2.5,iceFreeze:1.7, // buz: yavaşlık, kaç sn durunca donarsın, donma süresi
  rageMul:1.4,rageLinger:2,                    // öfke iksiri: düşmanın hız ve hasar çarpanı, iksirden çıkınca kaç sn sürer
  meteorEvery:3,meteorR:60,meteorDmg:30,meteorWarn:1.2,   // meteor: kaç sn'de bir, yarıçap, hasar, düşmeden önce uyarı
  healAmt:15,healTick:1,                       // şifalı su: can, aralık (sn)
  windSlow:.15                                 // tersine esinti: düşman yavaşlığı
};
const THEMES={
  lava:  {id:"lava",  bad:true, pools:true, ico:"🔥",name:"SICAK ZEMİN",  hint:"Lav göllerinden uzak dur!",           color:"#fb923c",fill:"#b91c1c",edge:"#fb923c",glow:"#fdba74"},
  ice:   {id:"ice",   bad:true, pools:true, ico:"🧊",name:"DONMUŞ HAVA",  hint:"Buzda durma, donup kalırsın!",        color:"#bae6fd",fill:"#7dd3fc",edge:"#f0f9ff",glow:"#e0f2fe"},
  rage:  {id:"rage",  bad:true, pools:true, ico:"💢",name:"ÖFKE İKSİRİ",  hint:"İksire değen düşman 1,4 kat hızlı ve sert!",color:"#f472b6",fill:"#9d174d",edge:"#f43f5e",glow:"#fda4af"},
  meteor:{id:"meteor",bad:true, pools:false,ico:"☄️",name:"TAŞTAN YAĞMUR",hint:"Gökten kayalar düşüyor, gölgelere dikkat!",color:"#fdba74",fill:"#78716c",edge:"#f97316",glow:"#fed7aa"},
  heal:  {id:"heal",  bad:false,pools:true, ico:"💧",name:"ŞİFALI SULAR", hint:"Suyun içinde dur, canın dolsun!",     color:"#67e8f9",fill:"#0e7490",edge:"#67e8f9",glow:"#a5f3fc"},
  wind:  {id:"wind",  bad:false,pools:false,ico:"🌬️",name:"TERSİNE ESİNTİ",hint:"Rüzgar düşmanları %15 yavaşlatıyor!",  color:"#bbf7d0",fill:"#34d399",edge:"#bbf7d0",glow:"#d1fae5"}
};

function inPoly(px,py,pts){
  let c=false;
  for(let i=0,j=pts.length-1;i<pts.length;j=i++){
    const a=pts[i],b=pts[j];
    if((a.y>py)!==(b.y>py)&&px<(b.x-a.x)*(py-a.y)/(b.y-a.y)+a.x)c=!c;
  }
  return c;
}
function inPools(x,y,kind){
  for(const p of fx.pools)if(p.kind===kind&&p.t>=MAPFX.poolWarn&&inPoly(x,y,p.pts))return true;
  return false;
}
function windFactor(){return(fx.theme==="wind"&&fx.phase==="active")?1-MAPFX.windSlow:1}

// Düzensiz şekilli bir göl üretir: her seferinde farklı yer, boyut ve şekil. Oyuncunun üstünde doğmaz.
function makePool(kind){
  for(let tries=0;tries<40;tries++){
    const r=rand(MAPFX.poolRadius[0],MAPFX.poolRadius[1]);
    const x=rand(r+20,W-r-20),y=rand(r+20,H-r-20);
    if(Math.hypot(x-player.x,y-player.y)<r*1.2+player.r+60)continue;
    const n=Math.floor(rand(9,14)),pts=[];
    const stretch=rand(.7,1.35),rot=rand(0,Math.PI);
    for(let i=0;i<n;i++){
      const a=i*Math.PI*2/n+rand(-.15,.15);
      const rr=r*rand(.72,1.15);
      const ex=Math.cos(a)*rr*stretch,ey=Math.sin(a)*rr/stretch;
      pts.push({x:Math.max(8,Math.min(W-8,x+ex*Math.cos(rot)-ey*Math.sin(rot))),
                y:Math.max(8,Math.min(H-8,y+ex*Math.sin(rot)+ey*Math.cos(rot)))});
    }
    return{x,y,r,pts,kind,t:0};
  }
  return null;
}

function announceTheme(th){
  $("tbName").textContent=th.ico+" "+th.name;
  $("tbName").style.color=th.color;
  $("tbHint").textContent=th.hint;
  retrigger($("themeBanner"),"go");
}

// forceId verilirse o tema seçilir (deneme için), yoksa ağırlıklı rastgele
function startTheme(forceId){
  let th;
  if(forceId)th=THEMES[forceId];
  else{
    const bad=Math.random()<MAPFX.badChance;
    let list=Object.values(THEMES).filter(t=>t.bad===bad&&t.id!==fx.last);
    if(!list.length)list=Object.values(THEMES).filter(t=>t.bad===bad);
    th=list[Math.floor(Math.random()*list.length)];
  }
  fx.theme=th.id;fx.last=th.id;
  fx.pools=[];fx.meteors=[];
  fx.iceT=0;fx.lavaT=MAPFX.lavaTick;fx.healT=MAPFX.healTick;fx.meteorT=1;
  if(th.pools){
    const n=Math.floor(rand(MAPFX.poolCount[0],MAPFX.poolCount[1]+1));
    for(let i=0;i<n;i++){const q=makePool(th.id);if(q)fx.pools.push(q)}
  }
  announceTheme(th);
}
function endTheme(){fx.theme=null;fx.pools=[];fx.meteors=[]}

function updateThemes(dt){
  const F=MAPFX;
  // döngü: mola -> aktif -> mola
  fx.t-=dt;
  if(fx.t<=0){
    if(fx.phase==="break"){startTheme();fx.phase="active";fx.t=F.activeT}
    else{endTheme();fx.phase="break";fx.t=F.breakT}
  }
  player.onIce=false;
  // donma: hareket, oto atak ve yetenek yok (hasar yemeye devam edersin)
  if(player.frozen>0){
    player.frozen=Math.max(0,player.frozen-dt);
    target=null;goal.x=player.x;goal.y=player.y;
    if(xo)xo.holding=false;
  }
  // düşmekte olan meteorlar (tema bitse de düşer)
  for(const m of [...fx.meteors]){
    m.t-=dt;
    if(m.t<=0){
      fx.meteors.splice(fx.meteors.indexOf(m),1);
      rings.push({x:m.x,y:m.y,r:F.meteorR,life:.35,color:"#fb923c"});
      burst(m.x,m.y,"#fdba74",22);
      if(Math.hypot(player.x-m.x,player.y-m.y)<F.meteorR+player.r*.6)playerHit(F.meteorDmg);
    }
  }
  if(fx.phase!=="active"||!fx.theme)return;
  const th=fx.theme;
  for(const q of fx.pools)q.t+=dt;
  const inside=kind=>fx.pools.some(q=>q.kind===kind&&q.t>=F.poolWarn&&inPoly(player.x,player.y,q.pts));
  if(th==="lava"||th==="rage"){                       // üstünde durunca 0.4 sn'de bir 5 hasar
    if(inside(th)){fx.lavaT-=dt;if(fx.lavaT<=0){fx.lavaT=F.lavaTick;playerHit(F.lavaDmg)}}
    else fx.lavaT=F.lavaTick;
  }
  if(th==="ice"){                                     // %30 yavaşlık, 2.5 sn durursan 1.7 sn donarsın
    if(inside("ice")){
      player.onIce=true;
      if(player.frozen<=0){
        fx.iceT+=dt;
        if(fx.iceT>=F.iceFreezeAfter){fx.iceT=0;player.frozen=F.iceFreeze;burst(player.x,player.y,"#e0f2fe",24)}
      }
    }else fx.iceT=0;
  }
  if(th==="heal"){                                    // içinde durunca 1 sn'de +15 can
    if(inside("heal")){
      fx.healT-=dt;
      if(fx.healT<=0){fx.healT+=F.healTick;player.hp=Math.min(player.maxHp,player.hp+F.healAmt);burst(player.x,player.y,"#67e8f9",10)}
    }else fx.healT=F.healTick;
  }
  if(th==="meteor"){                                  // haritanın rastgele yerlerine 3 sn'de bir
    fx.meteorT-=dt;
    if(fx.meteorT<=0){fx.meteorT=F.meteorEvery;fx.meteors.push({x:rand(50,W-50),y:rand(50,H-50),t:F.meteorWarn})}
  }
}

// Sağ üstteki iki süre göstergesi: toplam süre ve sonraki boss
function updateClocks(){
  $("time").textContent=fmtTime(totalTime);
  $("bossTime").textContent=bossState.boss?"BOSS":fmtTime(Math.max(0,bossState.next-elapsed));
  const chip=$("themeChip");
  if(fx.phase==="active"&&fx.theme){
    const th=THEMES[fx.theme];
    chip.style.display="inline-block";
    chip.className="chip "+(th.bad?"bad":"good");
    $("themeIco").textContent=th.ico;
    $("themeTime").textContent=Math.ceil(Math.max(0,fx.t))+"s";
  }else chip.style.display="none";
}

function poolPath(pts,cx,cy,k){
  ctx.beginPath();
  pts.forEach((q,i)=>{const x=cx+(q.x-cx)*k,y=cy+(q.y-cy)*k;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)});
  ctx.closePath();
}

// Zemindeki göller (düşmanların altında)
function drawThemes(){
  if(!fx||fx.phase!=="active"||!fx.theme)return;
  const th=THEMES[fx.theme],fade=Math.min(1,Math.max(0,fx.t));
  for(const q of fx.pools){
    const warn=q.t<MAPFX.poolWarn;
    ctx.globalAlpha=(warn?.3+.25*Math.sin(clock/55):.88)*fade;
    ctx.fillStyle=th.fill;poolPath(q.pts,q.x,q.y,1);ctx.fill();
    ctx.strokeStyle=th.edge;ctx.lineWidth=warn?2:4;
    if(warn)ctx.setLineDash([8,6]);
    ctx.stroke();ctx.setLineDash([]);
    if(!warn){
      ctx.globalAlpha=(.35+.15*Math.sin(clock/230+q.x))*fade;
      ctx.fillStyle=th.glow;poolPath(q.pts,q.x,q.y,.6);ctx.fill();
      ctx.globalAlpha=.5*fade;
      for(let i=0;i<3;i++){                           // kabarcıklar / parıltılar
        const a=clock/700+i*2.1+q.x,rr=q.r*.35;
        ctx.fillStyle=th.glow;
        ctx.beginPath();ctx.arc(q.x+Math.cos(a)*rr,q.y+Math.sin(a*1.3)*rr*.8,3+i,0,Math.PI*2);ctx.fill();
      }
    }
  }
  ctx.globalAlpha=1;
}

// Düşmanların üstünde: meteor gölgeleri ve kayalar, rüzgar çizgileri
function drawThemesOver(){
  if(!fx)return;
  for(const m of fx.meteors){
    const p=1-m.t/MAPFX.meteorWarn;
    ctx.fillStyle="rgba(239,68,68,"+(.12+p*.25)+")";
    ctx.beginPath();ctx.arc(m.x,m.y,MAPFX.meteorR,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle="#ef4444";ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle="rgba(239,68,68,.4)";
    ctx.beginPath();ctx.arc(m.x,m.y,MAPFX.meteorR*p,0,Math.PI*2);ctx.fill();
    const ry=m.y-(1-p)*260;
    ctx.fillStyle="rgba(249,115,22,.55)";ctx.beginPath();ctx.arc(m.x,ry-8,20,0,Math.PI*2);ctx.fill();
    ctx.fillStyle="#78716c";ctx.strokeStyle="#292524";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(m.x,ry,15,0,Math.PI*2);ctx.fill();ctx.stroke();
  }
  if(fx.theme==="wind"&&fx.phase==="active"){
    ctx.strokeStyle="rgba(226,232,240,"+(.28*Math.min(1,fx.t))+")";ctx.lineWidth=2;
    for(let i=0;i<30;i++){
      const sp=.35+(i%5)*.12;
      const x=((i*173+clock*sp)%(W+240))-120,y=(i*97+Math.sin(clock/900+i)*10)%H,len=60+(i%4)*22;
      ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-len,y+len*.12);ctx.stroke();
    }
  }
}

// Donmuş oyuncu (oyuncunun üstünde)
function drawFrozen(){
  if(player&&player.rooted>0){                      // ağa yapışmış
    ctx.strokeStyle="rgba(241,245,249,.85)";ctx.lineWidth=2;
    for(let i=0;i<8;i++){const a=i*Math.PI/4;ctx.beginPath();ctx.moveTo(player.x,player.y);ctx.lineTo(player.x+Math.cos(a)*30,player.y+Math.sin(a)*30);ctx.stroke()}
    for(const rr of [14,24]){ctx.beginPath();ctx.arc(player.x,player.y,rr,0,Math.PI*2);ctx.stroke()}
  }
  if(player&&player.poison){                        // zehirli
    ctx.strokeStyle="rgba(132,204,22,"+(.6+Math.sin(clock/90)*.25)+")";ctx.lineWidth=3;
    ctx.beginPath();ctx.arc(player.x,player.y,player.r+5,0,Math.PI*2);ctx.stroke();
  }
  if(!player||!(player.frozen>0))return;
  ctx.fillStyle="rgba(186,230,253,.6)";
  ctx.beginPath();ctx.arc(player.x,player.y,player.r+9,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle="#f0f9ff";ctx.lineWidth=3;ctx.stroke();
  ctx.fillStyle="#f0f9ff";ctx.font="bold 18px Arial";ctx.textAlign="center";
  ctx.fillText("❄",player.x,player.y+6);
  ctx.textAlign="left";
}

