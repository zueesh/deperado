function layEggs(b){
  const A=ARACH,n=b.phase2?A.eggCountRage:A.eggCount,sp=b.phase2?A.spiderPerEggRage:A.spiderPerEgg;
  for(let i=0;i<n;i++){
    let x,y,tries=0;
    do{x=rand(60,W-60);y=rand(60,H-60);tries++}
    while(tries<25&&(Math.hypot(x-player.x,y-player.y)<90||Math.hypot(x-b.x,y-b.y)<b.r+40));
    enemies.push({type:"egg",x,y,r:A.eggR,maxHp:A.eggHp,hp:A.eggHp,hatchT:A.eggLife,hatchMax:A.eggLife,spawnN:sp,
      damage:0,speed:0,attack:0,shot:0,slow:0,color:"#ede9fe",xpOverride:0});
    burst(x,y,"#ede9fe",8);
  }
