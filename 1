          blast:24,blastCap:2.2,blastR:80,fuse:.8},                              // patlama hasarı, hasar sınırı, alan, gecikme
  runner:{name:"Koşucu",       r:8, hp:1, dmg:22,speed:110,xp:2,chance:.12,color:"#ec4899",
