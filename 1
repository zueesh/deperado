function truesunLandUlt(){
  if(bossRushMode)bossRushSource="Kutsal İnfaz";const T=TUNE.truesun,u=tr.ult;player.x=u.x;player.y=u.y;tr.ult={phase:"impact",x:u.x,y:u.y,left:.35};
  for(const e of [...enemies]){const d=Math.hypot(e.x-u.x,e.y-u.y);if(d<T.ultCenter+e.r){e.hp-=220;burst(e.x,e.y,"#fef08a",12);if(e.hp<=0)killEnemy(e)}else if(d<T.ultCenter+120+e.r){e.stun=Math.max(e.stun||0,T.ultOuterStun)}}
  rings.push({x:u.x,y:u.y,r:T.ultCenter+120,life:.7,color:"#fde68a"});burst(u.x,u.y,"#fff7cc",48);
  tr.arena={x:u.x,y:u.y,left:T.arenaLife,radius:T.arenaRadius,tick:0,spikes:Array.from({length:14},(_,i)=>i*Math.PI*2/14)};
